<div class="carousel-controls" data-work-carousel hidden>
  <button class="carousel-button" type="button" data-work-prev aria-label="Previous work cards">
    <span aria-hidden="true">&lt;-</span>
    <span>Back</span>
  </button>
  <div class="carousel-progress" aria-hidden="true">
    <span data-work-progress></span>
  </div>
  <button class="carousel-button" type="button" data-work-next aria-label="Next work cards">
    <span>Next</span>
    <span aria-hidden="true">-&gt;</span>
  </button>
</div>
