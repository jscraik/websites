---
import Icon from "./Icon.astro";

const navItems = [
  { href: "/#work", label: "Work" },
  { href: "/now/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" }
];

const normalizePath = (path: string) => (path === "/" ? path : path.replace(/\/$/, ""));
const currentPath = normalizePath(Astro.url.pathname);
const currentFor = (href: string): "page" | undefined => {
  if (href.includes("#")) return undefined;
  return currentPath === normalizePath(href) ? "page" : undefined;
};
---

<header class="site-header header">
  <div class="container">
    <div class="row row-justify-center">
      <div class="col col-lg-8 col-md-10 col-sm-12">
        <nav class="nav-menu" aria-label="Primary navigation">
          <div class="nav-inner">
            <div class="nav-bg" aria-hidden="true"></div>
            <div class="nav-flip">
              <a class="icon-box cc-nav" href="/" aria-label="Home" aria-current={currentPath === "/" ? "page" : undefined}>
                <Icon name="home" />
              </a>
            </div>
            {navItems.map((item) => (
              <div class="nav-flip">
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={currentFor(item.href)}
                >
                  {item.label}
                </a>
              </div>
            ))}
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const navShells = document.querySelectorAll(".site-header .nav-inner");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  navShells.forEach((navShell) => {
    if (!(navShell instanceof HTMLElement)) return;

    const highlight = navShell.querySelector(".nav-bg");
    if (!(highlight instanceof HTMLElement)) return;

    const navStyle = getComputedStyle(navShell);
    const navFlipDuration = Number.parseFloat(navStyle.getPropertyValue("--nav-flip-duration-ms")) || 400;
    const navFlipEasing = navStyle.getPropertyValue("--nav-flip-ease").trim() || "cubic-bezier(0.165, 0.84, 0.44, 1)";

    const animateHighlightFrom = (highlightRect: DOMRect) => {
      if (reducedMotion.matches || highlightRect.width === 0 || highlightRect.height === 0) return;
      const settledRect = highlight.getBoundingClientRect();
      if (settledRect.width === 0 || settledRect.height === 0) return;

      const translateX = highlightRect.left - settledRect.left;
      const translateY = highlightRect.top - settledRect.top;
      const scaleX = highlightRect.width / settledRect.width;
      const scaleY = highlightRect.height / settledRect.height;

      highlight.animate(
        [
          { transform: `translate3d(${translateX}px, ${translateY}px, 0) scale(${scaleX}, ${scaleY})` },
          { transform: "none" }
        ],
        {
          duration: navFlipDuration,
          easing: navFlipEasing
        }
      );
    };

    const resetHighlight = () => {
      const highlightRect = highlight.getBoundingClientRect();
      highlight.getAnimations().forEach((animation) => animation.cancel());
      navShell.prepend(highlight);
      highlight.removeAttribute("data-active");
      animateHighlightFrom(highlightRect);
    };

    const moveHighlight = (target: Element) => {
      if (reducedMotion.matches || !(target instanceof HTMLElement)) {
        resetHighlight();
        return;
      }

      const highlightRect = highlight.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      if (targetRect.width === 0 || targetRect.height === 0) {
        resetHighlight();
        return;
      }

      highlight.getAnimations().forEach((animation) => animation.cancel());
      target.append(highlight);
      highlight.dataset.active = "true";
      animateHighlightFrom(highlightRect);
    };

    const syncHighlight = (source: "focus" | "pointer" = "focus") => {
      const focusedTarget = navShell.querySelector("a:focus-visible")?.closest(".nav-flip");
      const activeTarget =
        source === "pointer"
          ? navShell.querySelector(".nav-flip:hover")
          : focusedTarget ?? navShell.querySelector(".nav-flip:hover");
      if (activeTarget instanceof HTMLElement) {
        moveHighlight(activeTarget);
      } else {
        resetHighlight();
      }
    };

    const resyncHighlight = () => syncHighlight();

    navShell.addEventListener("pointerover", (event) => {
      if (!finePointer.matches || !(event.target instanceof Element)) return;
      const target = event.target.closest(".nav-flip");
      if (target && navShell.contains(target)) {
        syncHighlight("pointer");
      } else {
        resetHighlight();
      }
    });
    navShell.addEventListener("pointerleave", resyncHighlight);
    navShell.addEventListener("focusin", resyncHighlight);
    navShell.addEventListener("focusout", () => window.requestAnimationFrame(resyncHighlight));
    window.addEventListener("resize", resyncHighlight, { passive: true });
    reducedMotion.addEventListener("change", resyncHighlight);
  });
</script>
