---
const navItems = [
  { href: "/proof/", label: "Work" },
  { href: "/now/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" }
];
---

<header class="site-header header">
  <div class="container">
    <div class="row row-justify-center">
      <div class="col col-lg-8 col-md-10 col-sm-12">
        <nav class="nav-menu" aria-label="Primary navigation">
          <div class="nav-inner">
            <div class="nav-flip">
              <a class="icon-box cc-nav" href="/" aria-label="Home">
                <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false" class="sm-icon cc-nav">
                  <path d="M2 7.07037C2 6.40166 2.3342 5.7772 2.8906 5.40627L6.8906 2.7396C7.5624 2.29173 8.4376 2.29173 9.1094 2.7396L13.1094 5.40627C13.6658 5.7772 14 6.40166 14 7.07037V12C14 13.1046 13.1046 14 12 14H4C2.89543 14 2 13.1046 2 12V7.07037Z" />
                </svg>
              </a>
            </div>
            {navItems.map((item) => (
              <div class="nav-flip">
                <a href={item.href} class="nav-link">{item.label}</a>
              </div>
            ))}
            <div class="nav-bg" aria-hidden="true"></div>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>
