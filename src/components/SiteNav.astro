---
import Icon from "./Icon.astro";

const navItems = [
  { href: "/#work", label: "Work" },
  { href: "/now/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" }
];

const normalizePath = (path: string) => (path === "/" ? path : path.replace(/\/$/, ""));
const currentPath = normalizePath(Astro.url.pathname);
const currentFor = (href: string): "page" | undefined => {
  if (href.includes("#")) return undefined;
  return currentPath === normalizePath(href) ? "page" : undefined;
};
---

<header class="site-header header">
  <div class="container">
    <div class="row row-justify-center">
      <div class="col col-lg-8 col-md-10 col-sm-12">
        <nav class="nav-menu" aria-label="Primary navigation">
          <div class="nav-inner">
            <div class="nav-bg" aria-hidden="true"></div>
            <div class="nav-flip">
              <a class="icon-box cc-nav" href="/" aria-label="Home" aria-current={currentPath === "/" ? "page" : undefined}>
                <Icon name="home" />
              </a>
            </div>
            {navItems.map((item) => (
              <div class="nav-flip">
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={currentFor(item.href)}
                >
                  {item.label}
                </a>
              </div>
            ))}
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const navShells = document.querySelectorAll(".site-header .nav-inner");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  navShells.forEach((navShell) => {
    if (!(navShell instanceof HTMLElement)) return;

    const highlight = navShell.querySelector(".nav-bg");
    if (!(highlight instanceof HTMLElement)) return;

    const resetHighlight = () => {
      navShell.style.removeProperty("--nav-highlight-x");
      navShell.style.removeProperty("--nav-highlight-scale");
      highlight.removeAttribute("data-active");
    };

    const moveHighlight = (target: Element) => {
      if (reducedMotion.matches || !(target instanceof HTMLElement)) {
        resetHighlight();
        return;
      }

      const navRect = navShell.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      if (navRect.width === 0 || targetRect.width === 0) {
        resetHighlight();
        return;
      }

      navShell.style.setProperty("--nav-highlight-x", `${targetRect.left - navRect.left}px`);
      navShell.style.setProperty("--nav-highlight-scale", String(targetRect.width / navRect.width));
      highlight.dataset.active = "true";
    };

    const syncHighlight = () => {
      const activeTarget = navShell.querySelector(".nav-flip:hover, .nav-flip:focus-within");
      if (activeTarget instanceof HTMLElement) {
        moveHighlight(activeTarget);
      } else {
        resetHighlight();
      }
    };

    navShell.addEventListener("pointerover", (event) => {
      if (!finePointer.matches || !(event.target instanceof Element)) return;
      const target = event.target.closest(".nav-flip");
      if (target && navShell.contains(target)) moveHighlight(target);
    });
    navShell.addEventListener("pointerleave", syncHighlight);
    navShell.addEventListener("focusin", syncHighlight);
    navShell.addEventListener("focusout", () => window.requestAnimationFrame(syncHighlight));
    window.addEventListener("resize", syncHighlight, { passive: true });
    reducedMotion.addEventListener("change", syncHighlight);
  });
</script>
