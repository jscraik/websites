---
import BrandMark from "./BrandMark.astro";

const navItems = [
  { href: "/#work", label: "Work" },
  { href: "/now/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "mailto:jscraik@brainwav.io", label: "Contact" }
];

const normalizePath = (path: string) => (path === "/" ? path : path.replace(/\/$/, ""));
const currentPath = normalizePath(Astro.url.pathname);
const currentFor = (href: string): "page" | undefined => {
  if (href.includes("#")) return undefined;
  return currentPath === normalizePath(href) ? "page" : undefined;
};
---

<header class="site-header header">
  <div class="container">
    <div class="row row-justify-center">
      <div class="col col-lg-8 col-md-10 col-sm-12">
        <nav class="nav-menu" aria-label="Primary navigation">
          <div class="nav-inner">
            <div class="nav-flip">
              <BrandMark
                variant="tiny"
                className="icon-box cc-nav"
                ariaCurrent={currentPath === "/" ? "page" : undefined}
                label="Home"
              />
            </div>
            {navItems.map((item) => (
              <div class="nav-flip">
                <a href={item.href} class="nav-link" aria-current={currentFor(item.href)}>{item.label}</a>
              </div>
            ))}
            <div class="nav-bg" aria-hidden="true"></div>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>
