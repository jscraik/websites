---
import BrandMark from "./BrandMark.astro";

const navItems = [
  { href: "/#work", label: "Work" },
  { href: "/#brainwav", label: "brAInwav" },
  { href: "/now/", label: "About" },
  { href: "/blog/", label: "Writing" },
  { href: "/contact/", label: "Contact" }
];

const normalizePath = (path: string) => (path === "/" ? path : path.replace(/\/$/, ""));
const currentPath = normalizePath(Astro.url.pathname);
const currentFor = (href: string): "page" | undefined => {
  if (href.includes("#")) return undefined;
  return currentPath === normalizePath(href) ? "page" : undefined;
};
---

<header class="site-header header">
  <div class="container">
    <div class="row row-justify-center">
      <div class="col col-lg-8 col-md-10 col-sm-12">
        <nav class="nav-menu" aria-label="Primary navigation" data-nav-shell>
          <div class="nav-inner">
            <div class="nav-flip">
              <BrandMark
                variant="tiny"
                className="icon-box cc-nav"
                ariaCurrent={currentPath === "/" ? "page" : undefined}
                label="Home"
              />
            </div>
            {navItems.map((item) => (
              <div class="nav-flip">
                <a
                  href={item.href}
                  class:list={["nav-link", item.label === "brAInwav" && "nav-link--brand"]}
                  aria-current={currentFor(item.href)}
                >
                  {item.label === "brAInwav" ? (
                    <span class="brand-word">br<span>AI</span>nwav</span>
                  ) : item.label}
                </a>
              </div>
            ))}
            <div class="nav-bg" aria-hidden="true"></div>
            <div class="nav-hover-bg" aria-hidden="true"></div>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const navShells = document.querySelectorAll<HTMLElement>("[data-nav-shell]");

  navShells.forEach((shell) => {
    const inner = shell.querySelector<HTMLElement>(".nav-inner");
    const items = inner
      ? Array.from(inner.querySelectorAll<HTMLElement>(".nav-flip"))
      : [];
    const setHoverPill = (item: HTMLElement | undefined, visible: boolean) => {
      if (!inner || !item) {
        shell.style.setProperty("--nav-hover-opacity", "0");
        return;
      }

      const innerRect = inner.getBoundingClientRect();
      const itemRect = item.getBoundingClientRect();
      shell.style.setProperty("--nav-hover-x", `${itemRect.left - innerRect.left}px`);
      shell.style.setProperty("--nav-hover-w", `${itemRect.width}px`);
      shell.style.setProperty("--nav-hover-opacity", visible ? "1" : "0");
    };

    const resetHoverPill = () => setHoverPill(undefined, false);
    resetHoverPill();

    items.forEach((item) => {
      item.addEventListener("pointerenter", () => setHoverPill(item, true));
      item.addEventListener("focusin", () => setHoverPill(item, true));
    });

    inner?.addEventListener("pointerleave", resetHoverPill);
    inner?.addEventListener("focusout", (event) => {
      if (!inner.contains(event.relatedTarget as Node | null)) resetHoverPill();
    });

    window.addEventListener("resize", resetHoverPill, { passive: true });
  });
</script>
