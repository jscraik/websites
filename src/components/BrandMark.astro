---
interface Props {
  compact?: boolean;
  variant?: "primary" | "tiny" | "badge";
  className?: string;
  ariaCurrent?: "page";
  label?: string;
}

const {
  compact = false,
  variant = "primary",
  className = "",
  ariaCurrent,
  label
} = Astro.props;

const defaultLabel = variant === "badge" ? "Visible proof AI-native DevRel" : "Jamie Scott Craik home";
const ariaLabel = label ?? defaultLabel;

const isTiny = variant === "tiny";
const viewBox = isTiny ? "0 0 44 44" : "0 0 126 56";
---

<a
  class:list={["brand-mark", `brand-mark--${variant}`, compact && "brand-mark--compact", className]}
  href="/"
  aria-label={ariaLabel}
  aria-current={ariaCurrent}
>
  <span class="brand-mark__icon-shell" aria-hidden="true">
    <svg class="brand-mark__svg" viewBox={viewBox} focusable="false">
      {isTiny ? (
        <>
          <text class="brand-mark__letters" x="3" y="30">JSC</text>
          <path
            class="brand-mark__line"
            d="M3 9h26c7 0 11 4.8 11 12"
          />
          <circle class="brand-mark__dot" cx="39" cy="31" r="2.8" />
        </>
      ) : (
        <>
          <text class="brand-mark__letters" x="7" y="45">JSC</text>
          <path
            class="brand-mark__line"
            d="M7 10h79c15 0 25 10 25 27"
          />
          <circle class="brand-mark__dot" cx="113" cy="43" r="6.6" />
        </>
      )}
    </svg>
  </span>
  {variant === "badge" && (
    <span class="brand-mark__copy">
      <span>Visible proof</span>
      <span>AI-native DevRel</span>
    </span>
  )}
</a>
