---
interface Props {
  compact?: boolean;
  variant?: "primary" | "tiny" | "badge";
  className?: string;
  ariaCurrent?: "page";
  label?: string;
}

const {
  compact = false,
  variant = "primary",
  className = "",
  ariaCurrent,
  label
} = Astro.props;

const defaultLabel = variant === "badge" ? "Visible proof AI-native DevRel" : "Jamie Scott Craik home";
const ariaLabel = label ?? defaultLabel;

const isTiny = variant === "tiny";
const viewBox = isTiny ? "0 0 44 44" : "0 0 112 56";
---

<a
  class:list={["brand-mark", `brand-mark--${variant}`, compact && "brand-mark--compact", className]}
  href="/"
  aria-label={ariaLabel}
  aria-current={ariaCurrent}
>
  <span class="brand-mark__icon-shell" aria-hidden="true">
    <svg class="brand-mark__svg" viewBox={viewBox} focusable="false">
      {isTiny ? (
        <>
          <path
            class="brand-mark__home"
            d="M29 35.5H14.5a3.5 3.5 0 0 1-3.5-3.5V20.5L21.75 12 32.5 20.5V32a3.5 3.5 0 0 1-3.5 3.5Z"
          />
          <path
            class="brand-mark__roof"
            d="m8.5 21.5 13.25-10.7L35 21.5"
          />
        </>
      ) : (
        <>
          <text class="brand-mark__letters" x="8" y="45">JSC</text>
          <path
            class="brand-mark__line"
            d="M8 11h64c13 0 22 8 22 23"
          />
          <circle class="brand-mark__dot" cx="103" cy="38" r="4.2" />
        </>
      )}
    </svg>
  </span>
  {variant === "badge" && (
    <span class="brand-mark__copy">
      <span>Visible proof</span>
      <span>AI-native DevRel</span>
    </span>
  )}
</a>
