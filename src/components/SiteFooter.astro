---
const year = new Date().getFullYear();
---

<footer class="footer site-footer">
  <div class="container">
    <div class="row row-justify-center">
      <div class="col col-lg-10 col-sm-12">
        <div class="footer-inner">
          <a href="/" class="footer-profile-card" aria-label="Jamie Scott Craik home">
            <div class="pfp-img-wrap">
              <img src="/jamie-profile.png" alt="Jamie Scott Craik" class="u-img-cover" />
            </div>
            <div class="profile-row-meta">
              <div class="input-label">AI-native DevRel</div>
              <div class="input-label">Visible proof</div>
            </div>
          </a>
          <div class="footer-links" aria-label="Footer navigation">
            <a href="/proof/" class="nav-link cc-footer">Work</a>
            <a href="/now/" class="nav-link cc-footer">About</a>
            <a href="/blog/" class="nav-link cc-footer">Blog</a>
            <a href="/contact/" class="nav-link cc-footer">Contact</a>
          </div>
          <div class="footer-social-links" aria-label="Social links">
            <a href="https://github.com/jscraik" aria-label="GitHub" class="icon-box cc-social-link">GH</a>
            <a href="https://www.linkedin.com/in/jamie-scott-craik/" aria-label="LinkedIn" class="icon-box cc-social-link">in</a>
            <a href="https://x.com/jscraik" aria-label="X" class="icon-box cc-social-link">X</a>
          </div>
          <a class="footer-email" href="mailto:jscraik@brainwav.io">jscraik@brainwav.io</a>
        </div>
      </div>
    </div>
  </div>
  <p class="site-footer__credit">&copy; {year} Jamie Scott Craik</p>
</footer>
