---
import Icon from "./Icon.astro";

const links = [
  {
    href: "/demos/skillsbar/",
    label: "Start with SkillsBar",
    icon: "bookmark",
    primary: true
  },
  {
    href: "/#featured-work",
    label: "Read the featured projects",
    icon: "bookmark"
  },
  {
    href: "/now/#current-focus",
    label: "Read my career story",
    icon: "document"
  },
  {
    href: "/blog/",
    label: "Read a recent blog",
    icon: "pencil"
  }
];

---

<aside class="start-links" aria-labelledby="start-links-title">
  <p id="start-links-title" class="input-label u-mb-lg">Where you can start</p>
  <ul class="icon-link-list">
    {
      links.map((link) => (
        <li class="icon-link-item">
          <a
            href={link.href}
            class="icon-link"
            data-primary-start={link.primary ? "true" : undefined}
          >
            <span class="icon-box start-links__icon" aria-hidden="true">
              <Icon name={link.icon} />
            </span>
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
