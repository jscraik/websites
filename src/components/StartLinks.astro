---
import Icon from "./Icon.astro";

const links = [
  {
    href: "/now/",
    title: "Hiring",
    label: "Career story and experience",
    icon: "document"
  },
  {
    href: "/demos/skillsbar/",
    title: "Trying the tools",
    label: "Start with SkillsBar",
    icon: "bookmark",
    primary: true
  },
  {
    href: "/blog/",
    title: "Reading",
    label: "Articles and public notes",
    icon: "pencil"
  }
] as const;

---

<aside class="start-links" aria-labelledby="start-links-title">
  <p id="start-links-title" class="input-label">Start here</p>
  <ul class="icon-link-list">
    {
      links.map((link) => (
        <li class="icon-link-item">
          <a
            href={link.href}
            class="icon-link"
            data-primary-start={"primary" in link && link.primary ? "true" : undefined}
          >
            <span class="icon-box start-links__icon" aria-hidden="true">
              <Icon name={link.icon} />
            </span>
            <span class="start-links__copy"><strong>{link.title}</strong><span>{link.label}</span></span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
