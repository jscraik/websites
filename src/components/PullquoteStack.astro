---
type Pullquote = {
  figure: string;
  text: string;
};

const { quotes } = Astro.props as { quotes: Pullquote[] };
---

<aside class="pullquote-stack" aria-label="Shareable pullquotes">
  {quotes.map((quote) => (
    <figure class="pullquote-wrap">
      <div>
        <p class="input-label">{quote.figure}</p>
        <blockquote data-pullquote>{quote.text}</blockquote>
      </div>
      <figcaption>
        <p>Copy this pullquote and the article link for easy sharing</p>
        <button
          type="button"
          class="pullquote-button"
          data-copy-pullquote
          data-copy-label={`${quote.figure} pullquote and article link`}
          aria-label={`Copy ${quote.figure} pullquote and article link`}
        >
          <span>Copy</span>
        </button>
      </figcaption>
    </figure>
  ))}
  <p class="u-visually-hidden" data-copy-status role="status" aria-live="polite" aria-atomic="true"></p>
</aside>

<script>
  import { initPullquoteStacks } from "../scripts/pullquote-stack";

  initPullquoteStacks();
</script>
