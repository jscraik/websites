---
const { name, class: className = "sm-icon" } = Astro.props;

type IconName = "person" | "document" | "bookmark" | "pencil";

const icons: Record<IconName, { viewBox: string; paths: string[] }> = {
  person: {
    viewBox: "0 0 16 16",
    paths: [
      "M8 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
      "M2 15c0-1.6.63-3.12 1.76-4.24C4.88 9.63 6.41 9 8 9s3.12.63 4.24 1.76C13.37 11.88 14 13.41 14 15"
    ]
  },
  document: {
    viewBox: "0 0 16 16",
    paths: [
      "M4 1h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Z",
      "M4 4.75h5M4 7.75h8M4 10.75h8"
    ]
  },
  bookmark: {
    viewBox: "0 0 16 16",
    paths: [
      "M3 3c0-1.1.9-2 2-2h6c1.1 0 2 .9 2 2v11.04c0 .4-.46.64-.79.41l-3.92-2.75a.5.5 0 0 0-.58 0l-3.92 2.75A.5.5 0 0 1 3 14.04V3Z"
    ]
  },
  pencil: {
    viewBox: "0 0 17 16",
    paths: [
      "m13.89 6.85 1.24-1.24a2 2 0 0 0 0-2.83l-1.41-1.41a2 2 0 0 0-2.83 0L9.65 2.61",
      "m14.01 6.73-4.24-4.24-7.37 7.37a.5.5 0 0 0-.14.28l-.59 4.12a.5.5 0 0 0 .57.57l4.12-.59a.5.5 0 0 0 .28-.14l7.37-7.37Z"
    ]
  }
};

const icon = icons[name as IconName];
---

{icon && (
  <svg viewBox={icon.viewBox} class={className}>
    {icon.paths.map((path) => <path d={path}></path>)}
  </svg>
)}
