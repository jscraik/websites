---
import "../styles/global.css";
import "../styles/shell.css";
import "../styles/editorial-theme.css";
import "../styles/route-rhythm.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Jamie Scott Craik is moving into professional software development through source-backed products, developer tools, and AI-assisted delivery.",
  bodyClass,
  noIndex = false
} = Astro.props;
const canonicalUrl = Astro.url.href;
const preventIndexing = noIndex || import.meta.env.DEV || import.meta.env.MODE === "preview";

---

<!doctype html>
<html lang="en" class:list={{ "editorial-theme": bodyClass !== "skillsbar-demo" }} data-page={Astro.url.pathname}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={bodyClass === "skillsbar-demo" ? "#fbfaf5" : "#242629"} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/jamie-profile-640.webp", Astro.site ?? Astro.url.origin).href} />
    <meta property="og:image:alt" content="Portrait of Jamie Scott Craik" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Jamie Scott Craik — software development and AI-assisted work" href="/blog/rss.xml" />
    <link rel="preload" href="/brand/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/brand/fonts/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/brand/fonts/newsreader-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteNav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      document.querySelectorAll(".proof-row").forEach((row) => {
        row.addEventListener("focusin", (event) => {
          if (event.target instanceof HTMLElement && event.target.matches(".proof-card")) {
            event.target.scrollIntoView({ behavior: "instant", block: "nearest", inline: "center" });
          }
        });
      });

    </script>
  </body>
</html>
