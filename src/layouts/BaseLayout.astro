---
import "../styles/global.css";
import "../styles/shell.css";
import "../styles/route-rhythm.css";
import SiteNav from "../components/SiteNav.astro";
import { createRequire } from "node:module";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = "Jamie Scott Craik turns AI-assisted developer work into inspectable workflows through agent skills, Codex, evals, and evidence-backed tooling.",
  bodyClass
} = Astro.props;
const canonicalUrl = Astro.url.href;
const isDevelopment = import.meta.env.DEV;
const lapseInspectorAvailable = isDevelopment && (() => {
  try {
    createRequire(import.meta.url).resolve("@aiforui/lapse/panel");
    return true;
  } catch {
    return false;
  }
})();

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Jamie Scott Craik — AI workflow delivery" href="/blog/rss.xml" />
    <link rel="preload" href="/brand/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/brand/fonts/newsreader-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {lapseInspectorAvailable && <script type="module" src="/src/scripts/lapse-dev.ts"></script>}
    <SiteNav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { moveLayerWithFlip } from "../scripts/flip-motion";

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      const animatedButtons = document.querySelectorAll(".small-button");

      animatedButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;

        const background = button.querySelector(".small-button__bg");
        const arrow = button.querySelector(".small-button__arrow");
        if (!(background instanceof HTMLElement) || !(arrow instanceof HTMLElement)) return;

        const resetBackground = () => {
          if (background.parentElement !== button) {
            moveLayerWithFlip(background, button, {
              animate: !reducedMotion.matches,
            });
          }
          button.removeAttribute("data-flip-active");
        };

        button.addEventListener("pointerenter", () => {
          if (!finePointer.matches || reducedMotion.matches) return;
          moveLayerWithFlip(background, arrow);
          button.dataset.flipActive = "true";
        });
        button.addEventListener("pointerleave", resetBackground);
        reducedMotion.addEventListener("change", resetBackground);
      });

      const workCarousels = document.querySelectorAll("[data-work-carousel]");

      workCarousels.forEach((workCarousel) => {
        const section = workCarousel.closest(".work-carousel");
        const workRow = section?.querySelector("[data-work-row]");

        if (!(workRow instanceof HTMLElement) || !(workCarousel instanceof HTMLElement)) {
          return;
        }

        const previousButton = workCarousel.querySelector("[data-work-prev]");
        const nextButton = workCarousel.querySelector("[data-work-next]");
        const progress = workCarousel.querySelector("[data-work-progress]");

        const updateControls = () => {
          const maxScroll = workRow.scrollWidth - workRow.clientWidth;
          if (maxScroll <= 24) {
            workCarousel.hidden = true;
            return;
          }

          workCarousel.hidden = false;

          const ratio = maxScroll > 0 ? workRow.scrollLeft / maxScroll : 0;
          if (progress instanceof HTMLElement) {
            progress.style.transform = `scaleX(${Math.max(0.18, Math.min(1, ratio || 0.18))})`;
          }
          if (previousButton instanceof HTMLButtonElement) {
            previousButton.disabled = workRow.scrollLeft <= 4;
          }
          if (nextButton instanceof HTMLButtonElement) {
            nextButton.disabled = workRow.scrollLeft >= maxScroll - 4;
          }
        };

        const scrollCards = (direction: number) => {
          workRow.scrollBy({
            left: direction * Math.max(288, workRow.clientWidth * 0.72),
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth"
          });
        };

        if (previousButton instanceof HTMLButtonElement) {
          previousButton.addEventListener("click", () => scrollCards(-1));
        }
        if (nextButton instanceof HTMLButtonElement) {
          nextButton.addEventListener("click", () => scrollCards(1));
        }

        workRow.addEventListener("scroll", updateControls, { passive: true });
        window.addEventListener("resize", updateControls);
        window.addEventListener("load", updateControls);
        updateControls();
      });
    </script>
  </body>
</html>
