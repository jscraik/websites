---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import AnimatedButton from "../../components/AnimatedButton.astro";
import { getCollection } from "astro:content";
import { byOrder } from "../../lib/portfolio";
import type { CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const blogEntries: BlogEntry[] = (await getCollection("blog")).sort(byOrder);
const articles = blogEntries.filter((article) => article.data.publicationState === "published");
const drafts = blogEntries.filter((article) => article.data.publicationState === "draft");
const latestArticle = articles.find((article) => article.data.featured) ?? articles[0];
if (!latestArticle) {
  throw new Error("No blog entries found in the 'blog' content collection");
}
const otherArticles = articles.filter((article) => article.id !== latestArticle.id);
---

<BaseLayout title="Writing | Jamie Scott Craik" description="Technical writing from Jamie Scott Craik about software projects, AI-assisted delivery, developer tools, and lessons from a career switch.">
  <header class="blog-index section-shell" aria-labelledby="blog-title">
    <div class="blog-title-block">
      <div class="blog-heading-lockup">
        <h1 id="blog-title">Writing</h1>
        <span class="icon-box blog-heading-icon" aria-hidden="true">
          <Icon name="pencil" />
        </span>
      </div>
      <div class="draft-links">
        <p class="eyebrow">Writing next</p>
        {drafts.map((draft) => (
          <span><Icon name="document" />{draft.data.title}</span>
        ))}
        <a class="blog-rss-link" href="/blog/rss.xml">RSS feed</a>
      </div>
    </div>

    <section class="latest-article" aria-labelledby="latest-article-title">
      <article>
        <div>
          <p class="eyebrow">Latest article · {latestArticle.data.category}</p>
          <h2 id="latest-article-title">{latestArticle.data.title}</h2>
          <p class="article-date">{latestArticle.data.date}</p>
        </div>
        <div>
          <p>{latestArticle.data.summary}</p>
        </div>
        <div>
          <AnimatedButton
            class="small-button--light"
            href={latestArticle.data.href}
            label="Keep reading"
          />
        </div>
      </article>
    </section>
  </header>

  <div class="blog-page-main">
    {otherArticles.length > 0 && (
      <section class="article-list" aria-labelledby="article-list-title">
        <h2 id="article-list-title">Browse all articles</h2>
        {otherArticles.map((article: BlogEntry) => (
          <article class="blog-list-item">
            <div>
              <p>{article.data.category} · {article.data.date}</p>
              <h3>{article.data.title}</h3>
            </div>
            <span>{article.data.summary}</span>
            <a href={article.data.href!} aria-label={`Read article: ${article.data.title}`}>Read</a>
          </article>
        ))}
      </section>
    )}

    <section class="blog-about-card" aria-labelledby="blog-about-title">
      <img
        src="/jamie-profile-480.webp"
        srcset="/jamie-profile-480.webp 480w, /jamie-profile-640.webp 640w"
        sizes="(max-width: 640px) calc(100vw - 40px), 480px"
        alt="Jamie Scott Craik"
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      />
      <div class="blog-author-copy">
        <h2 id="blog-about-title">About Jamie</h2>
        <div class="text-lg w-richtext">
          <p>
            I am moving into professional software development through independent
            products, developer tools, and technical writing.
          </p>
          <p>
            I write from work I can inspect: the decision, the implementation,
            the result, and the limitation that still matters.
          </p>
          <p>Thank you for reading.</p>
        </div>
        <div class="blog-contact-block">
          <p class="eyebrow">Contact me</p>
          <a href="mailto:jscraik@brainwav.io">jscraik@brainwav.io</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(body:has(.blog-index)) {
    background: var(--paper);
  }

  .blog-index {
    display: grid;
    width: min(1100px, calc(100% - var(--space-6)));
    margin-inline: auto;
    align-items: start;
  }

  .blog-heading-lockup {
    display: flex;
    align-items: flex-start;
    width: 100%;
  }

  .blog-heading-icon {
    display: grid;
  }

  .blog-title-block h1 {
    max-width: 100%;
    margin: 0;
    color: rgba(0, 11, 0, 0.78);
    font-family: var(--body-serif);
    font-weight: var(--bds-type-display-xl-weight);
    line-height: 0.86;
    letter-spacing: 0;
  }

  .draft-links {
    border-top: var(--border-hairline) solid var(--border-subtle);
    border-bottom: var(--border-hairline) solid var(--border-subtle);
    padding: var(--space-2) 0;
  }

  .draft-links .eyebrow {
    margin-bottom: var(--space-2);
  }

  .draft-links span {
    display: grid;
    grid-template-columns: var(--space-4) minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-1) 0;
    color: var(--neutral-07);
    font-family: var(--body-serif);
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 300;
    line-height: 1.25;
  }

  .draft-links span :global(.sm-icon) {
    align-self: start;
    width: var(--space-3);
    height: var(--space-3);
    margin-top: 0.18em;
    color: var(--bds-color-portfolio-muted);
  }

  .blog-rss-link {
    display: inline-flex;
    width: fit-content;
    margin-top: var(--space-3);
    padding-bottom: 3px;
    border-bottom: 1px solid currentcolor;
    color: var(--bds-color-portfolio-muted);
    font-family: var(--body-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .latest-article {
    width: 100%;
    max-width: none;
    padding-top: 0;
  }

  .latest-article article {
    display: block;
    width: 100%;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .latest-article article > div:first-child .eyebrow {
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-4);
    padding: 5px 9px;
    border: 1px solid rgba(0, 11, 0, 0.08);
    border-radius: var(--radius-pill);
    background: rgba(251, 250, 245, 0.62);
    color: var(--bds-color-portfolio-muted);
    line-height: 1;
  }

  .latest-article h2 {
    max-width: 430px;
    margin: 0;
    color: rgba(11, 15, 20, 0.82);
    font-family: var(--body-sans);
    font-weight: 600;
    line-height: 1.22;
  }

  .latest-article .article-date {
    margin-top: var(--space-2);
  }

  .latest-article p:not(.eyebrow, .article-date) {
    max-width: 470px;
    color: var(--neutral-07);
    font-family: var(--body-serif);
    font-weight: 300;
    line-height: 1.44;
  }

  .latest-article .small-button {
    width: fit-content;
    min-width: 150px;
    margin-top: var(--space-3);
    border-color: rgba(0, 11, 0, 0.06);
    background: transparent;
  }

  .article-list {
    display: grid;
    width: min(1100px, calc(100% - var(--space-6)));
    max-width: 1100px;
    margin-inline: auto;
    margin-block: 0;
    padding-bottom: 0;
  }

  .article-list h2 {
    position: static;
    width: 100%;
    max-width: none;
    color: rgba(61, 64, 60, 0.86);
    font-family: var(--body-serif);
    font-weight: var(--bds-type-display-lg-weight);
    letter-spacing: 0;
  }

  .blog-list-item {
    display: grid;
    width: 100%;
    border-top: var(--border-hairline) solid var(--border-subtle);
  }

  .blog-list-item:last-child {
    border-bottom: var(--border-hairline) solid var(--border-subtle);
  }

  .blog-list-item > div {
    display: grid;
    gap: var(--space-4);
  }

  .blog-list-item > div p {
    margin: 0;
    color: var(--bds-color-portfolio-muted);
    font-family: var(--body-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .blog-list-item h3 {
    max-width: 360px;
    margin: 0;
    color: rgba(11, 15, 20, 0.82);
    font-family: var(--body-sans);
    font-weight: 600;
    line-height: 1.16;
  }

  .blog-list-item > span {
    max-width: 430px;
    color: var(--bds-color-portfolio-muted);
    font-family: var(--body-serif);
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 300;
    line-height: 1.36;
  }

  .blog-list-item > a {
    width: fit-content;
    padding-bottom: 3px;
    border-bottom: 1px solid currentcolor;
    color: var(--bds-color-portfolio-muted);
    font-family: var(--body-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .blog-about-card {
    display: grid;
    width: min(1100px, calc(100% - var(--space-6)));
    max-width: 1100px;
    margin-inline: auto;
    margin-block: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .blog-about-card img {
    width: 100%;
    border-radius: var(--radius-image);
    object-fit: cover;
    box-shadow: 0 38px 90px rgba(0, 11, 0, 0.14);
  }

  .blog-about-card > div {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .blog-about-card h2 {
    color: rgba(61, 64, 60, 0.86);
    font-family: var(--body-serif);
    font-weight: var(--bds-type-display-lg-weight);
    letter-spacing: 0;
  }

  .blog-about-card p:not(.eyebrow) {
    color: var(--bds-color-portfolio-muted);
    font-family: var(--body-serif);
    font-weight: 300;
  }

  @media (min-width: 57.5625rem) {
    .blog-index {
      grid-template-columns: minmax(0, 430px) minmax(0, 480px);
      column-gap: clamp(var(--space-7), 11vw, 168px);
      justify-content: center;
      padding-top: clamp(132px, 14.5vh, 172px);
      padding-bottom: clamp(104px, 11vh, 132px);
    }

    .blog-title-block {
      grid-column: 1;
    }

    .latest-article {
      grid-column: 2;
    }

    .blog-title-block h1 {
      margin-bottom: clamp(232px, 28vh, 288px);
      font-size: clamp(92px, 7.2vw, 104px);
    }

    .latest-article h2 {
      font-size: clamp(26px, 2.3vw, 34px);
    }

    .latest-article p:not(.eyebrow, .article-date) {
      margin-top: clamp(62px, 7vh, 78px);
      font-size: clamp(24px, 1.9vw, 29px);
    }

    .article-list {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: clamp(104px, 12vh, 150px);
    }

    .article-list h2 {
      margin: 0 0 clamp(46px, 5vh, 62px);
      padding-bottom: clamp(34px, 4vh, 48px);
      border-bottom: var(--border-hairline) solid var(--border-subtle);
      font-size: clamp(48px, 4.6vw, 66px);
      line-height: 1.02;
    }

    .blog-list-item {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(var(--space-6), 8vw, 108px);
      padding: 0 0 clamp(54px, 6vh, 72px);
    }

    .blog-list-item h3 {
      font-size: clamp(28px, 2.2vw, 34px);
    }

    .blog-list-item > a {
      grid-column: 2;
      justify-self: start;
      margin-top: clamp(18px, 2.4vh, 30px);
    }

    .blog-about-card {
      grid-template-columns: minmax(0, 390px) minmax(0, 500px);
      gap: clamp(var(--space-6), 9vw, 132px);
      align-items: start;
      padding-bottom: clamp(112px, 15vh, 172px);
    }

    .blog-about-card img {
      aspect-ratio: 0.75;
      object-position: 50% 32%;
    }

    .blog-about-card h2 {
      margin: 0 0 clamp(var(--space-4), 5vh, 54px);
      font-size: clamp(50px, 4.6vw, 68px);
      line-height: 1.02;
    }

    .blog-about-card p:not(.eyebrow) {
      font-size: clamp(23px, 1.8vw, 27px);
      line-height: 1.46;
    }
  }

  @media (max-width: 920px) {
    .blog-index,
    .article-list,
    .blog-about-card {
      width: min(100%, calc(100% - var(--space-4) - var(--space-4)));
    }

    .blog-index,
    .blog-list-item,
    .blog-about-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .blog-index {
      gap: var(--space-5);
      padding-top: 84px;
      padding-bottom: var(--space-7);
    }

    .blog-index .blog-heading-lockup {
      padding-top: calc(var(--space-4) - 1px);
    }

    .blog-title-block h1 {
      margin-bottom: var(--space-3);
      font-size: clamp(3.25rem, 14vw, 3.5rem);
      line-height: 0.95;
    }

    .blog-index .draft-links {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0;
      border: 0;
    }

    .blog-index .draft-links .eyebrow {
      margin: 0 0 var(--space-1);
    }

    .blog-index .draft-links span {
      grid-template-columns: var(--space-2) minmax(0, 1fr);
      gap: var(--space-2);
      padding: 0;
      font-size: clamp(0.9375rem, 4vw, 1rem);
      line-height: 1.625;
    }

    .blog-index .draft-links span:first-of-type {
      margin-top: var(--space-2);
      padding-top: 0;
      border-top: var(--border-hairline) solid var(--border-subtle);
    }

    .blog-index .draft-links span + span {
      margin-top: var(--space-1);
    }

    .blog-index .draft-links span:last-of-type {
      margin-bottom: var(--space-2);
      padding-bottom: 0;
      border-bottom: var(--border-hairline) solid var(--border-subtle);
    }

    .blog-index .draft-links span :global(.sm-icon) {
      width: var(--space-2);
      height: var(--space-2);
    }

    .blog-index.blog-index .latest-article h2 {
      font-size: clamp(1.125rem, 4.86vw, 1.25rem);
      line-height: 1.4;
      font-family: var(--body-sans);
      font-weight: 600;
    }

    .latest-article article > div:first-child .eyebrow {
      display: block;
      width: fit-content;
      margin: 0 0 var(--space-2);
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      line-height: 1.4;
    }

    .latest-article p:not(.eyebrow, .article-date) {
      margin-top: var(--space-5);
      font-size: 22px;
    }

    .article-list h2 {
      margin-bottom: var(--space-4);
      font-size: clamp(42px, 11vw, 58px);
    }

    .blog-list-item {
      gap: var(--space-2);
      padding: var(--space-4) 0;
    }

    .blog-list-item > a {
      justify-self: start;
      margin-top: var(--space-1);
    }

    .blog-about-card {
      gap: var(--space-5);
      padding-bottom: var(--space-8);
    }

    .blog-about-card img {
      aspect-ratio: 3 / 4;
      object-fit: cover;
    }
  }

  @media (min-width: 57.5626rem) {
    .blog-index.section-shell {
      display: grid;
      grid-template-columns: 3fr 1fr 4fr;
      column-gap: 0;
      width: min(67.6667vw, calc(var(--jp-fluid-rem) * 67.6667));
      max-width: calc(var(--jp-fluid-rem) * 67.6667);
      min-height: calc(var(--jp-fluid-rem) * 45);
      padding: calc(var(--jp-fluid-rem) * 8.5) 0 calc(var(--jp-fluid-rem) * 6);
      background: var(--paper);
    }

    .blog-index .blog-title-block {
      grid-column: 1;
      width: 100%;
      min-height: 100%;
    }

    .blog-index .latest-article {
      grid-column: 3;
      width: 100%;
      max-width: none;
      padding: 0;
    }

    .blog-title-block h1 {
      margin: 0;
      font-size: calc(var(--jp-fluid-rem) * 6);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    .blog-index .draft-links span {
      grid-template-columns: calc(var(--jp-fluid-rem) * 1) minmax(0, 1fr);
      gap: calc(var(--jp-fluid-rem) * 0.75);
      font-size: calc(var(--jp-fluid-rem) * 1);
      line-height: 1.5;
    }

    .latest-article article {
      display: flex;
      flex-direction: column;
      gap: calc(var(--jp-fluid-rem) * 3.5);
    }

    .latest-article h2 {
      max-width: calc(var(--jp-fluid-rem) * 25);
      font-size: calc(var(--jp-fluid-rem) * 1.25);
      line-height: 1.4;
    }

    .latest-article p:not(.eyebrow, .article-date) {
      max-width: calc(var(--jp-fluid-rem) * 32.333);
      margin: 0;
      font-size: calc(var(--jp-fluid-rem) * 1.125);
      line-height: 1.6;
    }

    .blog-page-main {
      display: grid;
      gap: calc(var(--jp-fluid-rem) * 8);
      padding: 0 0 calc(var(--jp-fluid-rem) * 8);
      background: var(--paper);
    }

    .article-list {
      display: flex;
      flex-direction: column;
      gap: calc(var(--jp-fluid-rem) * 3.5);
      width: min(66.1667vw, calc(var(--jp-fluid-rem) * 66.1667));
      max-width: calc(var(--jp-fluid-rem) * 66.1667);
      margin-inline: auto;
      padding: 0;
    }

    .article-list h2 {
      margin: 0;
      padding: 0;
      border: 0;
      font-size: calc(var(--jp-fluid-rem) * 3.125);
      line-height: 1.2;
      letter-spacing: -0.03em;
    }

    .blog-list-item {
      display: flex;
      flex-direction: column;
      gap: calc(var(--jp-fluid-rem) * 1.5);
      padding: 0 0 calc(var(--jp-fluid-rem) * 3);
      border-top: 0;
      border-bottom: 0;
    }

    .blog-list-item + .blog-list-item {
      padding-top: calc(var(--jp-fluid-rem) * 1);
    }

    .blog-list-item h3 {
      max-width: calc(var(--jp-fluid-rem) * 25);
      font-size: calc(var(--jp-fluid-rem) * 1.25);
      line-height: 1.4;
    }

    .blog-list-item > span {
      max-width: calc(var(--jp-fluid-rem) * 32.333);
      font-size: calc(var(--jp-fluid-rem) * 1.125);
      line-height: 1.6;
    }

    .blog-list-item > a {
      margin: 0;
      padding-bottom: 0;
      border-bottom: 2px solid rgba(0, 11, 0, 0.12);
      font-size: calc(var(--jp-fluid-rem) * 0.75);
      line-height: 1.4;
    }

    .blog-about-card {
      display: grid;
      grid-template-columns: 3fr 1fr 4fr;
      column-gap: 0;
      width: min(67.6667vw, calc(var(--jp-fluid-rem) * 67.6667));
      max-width: calc(var(--jp-fluid-rem) * 67.6667);
      margin-inline: auto;
      padding: calc(var(--jp-fluid-rem) * 1) 0 calc(var(--jp-fluid-rem) * 2);
      background: var(--paper);
    }

    .blog-about-card img {
      grid-column: 1;
      justify-self: center;
      width: calc(var(--jp-fluid-rem) * 16);
      max-width: 100%;
      aspect-ratio: 3 / 4;
      height: auto;
      object-fit: cover;
      object-position: 50% 32%;
    }

    .blog-about-card .blog-author-copy {
      grid-column: 3;
      display: flex;
      flex-direction: column;
      gap: calc(var(--jp-fluid-rem) * 2);
      width: 100%;
      max-width: calc(var(--jp-fluid-rem) * 32.333);
      padding: 0;
      border: 0;
      background: transparent;
    }

    .blog-about-card h2 {
      margin: 0;
      font-size: calc(var(--jp-fluid-rem) * 3.125);
      line-height: 1.2;
      letter-spacing: -0.03em;
    }

    .blog-about-card .text-lg {
      display: grid;
      gap: calc(var(--jp-fluid-rem) * 1);
      font-size: calc(var(--jp-fluid-rem) * 1.125);
      line-height: 1.6;
    }

    .blog-about-card .text-lg p {
      margin: 0;
      color: var(--bds-color-portfolio-muted);
    }

    .blog-contact-block {
      display: grid;
      gap: calc(var(--jp-fluid-rem) * 0.25);
    }
  }

  /* Keep the editorial lockup readable before the three-column desktop grid
     has enough room for its title, draft list, and lead article. */
  @media (min-width: 57.5626rem) and (max-width: 72rem) {
    .blog-index.section-shell {
      grid-template-columns: minmax(0, 1fr);
      width: min(calc(100% - var(--space-5)), 720px);
      max-width: 720px;
      min-height: 0;
      gap: var(--space-6);
      padding-top: clamp(96px, 12vw, 132px);
      padding-bottom: var(--space-7);
    }

    .blog-index .blog-title-block,
    .blog-index .latest-article {
      grid-column: 1;
    }

    .blog-index .blog-title-block {
      min-height: 0;
      gap: var(--space-5);
    }

    .blog-title-block h1 {
      margin-bottom: var(--space-5);
      font-size: clamp(72px, 10vw, 96px);
      line-height: 0.95;
    }

    .draft-links span {
      font-size: clamp(20px, 2.1vw, 26px);
    }

    .latest-article article {
      gap: var(--space-5);
    }

    .latest-article h2 {
      max-width: none;
      font-size: clamp(24px, 3vw, 30px);
      line-height: 1.2;
    }

    .latest-article p:not(.eyebrow, .article-date) {
      max-width: 38rem;
      margin: 0;
      font-size: clamp(22px, 2.4vw, 26px);
      line-height: 1.45;
    }
  }

  @media (min-width: 72.0001rem) {
    .blog-index {
      width: min(62.12vw, calc(var(--jp-fluid-rem) * 62.12));
      max-width: calc(var(--jp-fluid-rem) * 62.12);
      min-height: calc(var(--jp-fluid-rem) * 52.83);
    }

    .latest-article article {
      justify-content: space-between;
