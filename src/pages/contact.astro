---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicProfile } from "../lib/public-profile";
---

<BaseLayout title="Contact | Jamie Scott Craik" description="Contact Jamie Scott Craik about software-development roles, career-switcher opportunities, and collaborative projects.">
  <section class="plain-page contact-page section-shell">
    <div>
      <p class="eyebrow">Contact</p>
      <h1>Email Jamie Scott Craik</h1>
      <p>For roles and collaborations, send me an email. You can find my background and availability on the <a href="/now/">About page</a>.</p>
      <a class="large-link" href={publicProfile.links.email}>{publicProfile.links.emailLabel}</a>
    </div>
    <div class="contact-panel">
      <div class="contact-links" aria-label="External profiles">
        <a href={publicProfile.links.github}>GitHub</a>
        <a href={publicProfile.links.linkedin}>LinkedIn</a>
        <a href="https://x.com/jscraik">X</a>
      </div>
    </div>
  </section>
</BaseLayout>
