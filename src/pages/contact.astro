---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | brAInwav">
  <section class="plain-page contact-page section-shell">
    <div>
      <p class="eyebrow">Contact</p>
      <h1>Talk to me about deploying trustworthy AI workflows.</h1>
      <img class="contact-photo" src="/jamie-profile-640.webp" alt="Jamie Scott Craik" width="640" height="640" />
    </div>
    <div class="contact-panel">
      <p>
        I am looking for customer-facing AI deployment, implementation, solutions,
        technical delivery, and developer-experience roles. I bring agent skills,
        Codex workflows, evals, technical education, and a habit of making claims
        inspectable before asking anyone to trust them.
      </p>
      <a class="large-link" href="mailto:jscraik@brainwav.io">jscraik@brainwav.io</a>
      <div class="contact-links" aria-label="External profiles">
        <a href="https://github.com/jscraik">GitHub</a>
        <a href="https://www.linkedin.com/in/jscraik/">LinkedIn</a>
        <a href="https://x.com/jscraik">X</a>
      </div>
    </div>
  </section>
</BaseLayout>
