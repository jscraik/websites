---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byOrder } from "../../lib/portfolio";
import type { CollectionEntry } from "astro:content";

type ProofEntry = CollectionEntry<"proof">;
type ProofItem = ProofEntry["data"];

const proofItems: ProofItem[] = (await getCollection("proof"))
  .sort(byOrder)
  .map((entry: ProofEntry) => entry.data);

const liveProofItems = proofItems.filter((item: ProofItem) => item.status !== "Planned");
const plannedProofItems = proofItems.filter((item: ProofItem) => item.status === "Planned");
---

<BaseLayout title="Proof Index | brAInwav">
  <section class="proof-index section-shell" aria-labelledby="proof-title">
    <header>
      <p class="eyebrow">Proof surface</p>
      <h1 id="proof-title">All work</h1>
      <p>
        A deliberately small index of public artifacts. Each item keeps the claim,
        evidence, and caveat visible.
      </p>
    </header>

    <div class="section-label proof-label">
      <span>Featured proof</span>
      <span>Curated proof</span>
    </div>

    <div class="proof-row" role="region" aria-label="Featured proof" tabindex="0">
      {liveProofItems.map((item: ProofItem) => (
        <a class="proof-card" href={item.href}>
          <span>{item.status}</span>
          <h2>{item.title}</h2>
          <p>{item.claim}</p>
          <dl>
            <div>
              <dt>Evidence</dt>
              <dd>{item.evidence}</dd>
            </div>
            <div>
              <dt>Caveat</dt>
              <dd>{item.caveat}</dd>
            </div>
            <div>
              <dt>Next state</dt>
              <dd>{item.nextState}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>

    <div class="section-label proof-label">
      <span>Planned lanes</span>
      <span>Not proof yet</span>
    </div>

    <div class="proof-row" role="region" aria-label="Planned proof lanes" tabindex="0">
      {plannedProofItems.map((item: ProofItem) => (
        <div class="proof-card proof-card--planned">
          <span>{item.status}</span>
          <h2>{item.title}</h2>
          <p>{item.claim}</p>
          <dl>
            <div>
              <dt>Evidence</dt>
              <dd>{item.evidence}</dd>
            </div>
            <div>
              <dt>Caveat</dt>
              <dd>{item.caveat}</dd>
            </div>
            <div>
              <dt>Next state</dt>
              <dd>{item.nextState}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
