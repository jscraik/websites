---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byOrder, workRoute } from "../../lib/portfolio";
import type { CollectionEntry } from "astro:content";

type ProofEntry = CollectionEntry<"proof">;
type WorkEntry = CollectionEntry<"work">;
type ProofItem = ProofEntry["data"];

const workItems: WorkEntry[] = (await getCollection("work"))
  .filter((entry: WorkEntry) => entry.data.publicationState === "published")
  .sort(byOrder);

const proofItems: ProofItem[] = (await getCollection("proof"))
  .filter((entry: ProofEntry) => entry.data.publicationState === "published")
  .sort(byOrder)
  .map((entry: ProofEntry) => entry.data);

const liveProofItems = proofItems.filter((item: ProofItem) => item.status !== "Planned");
const plannedProofItems = proofItems.filter((item: ProofItem) => item.status === "Planned");
---

<BaseLayout title="Proof Index | brAInwav" description="A deliberately small index of public artifacts. Each item keeps the claim, evidence, and caveat visible.">
  <section class="proof-index section-shell" aria-labelledby="proof-title">
    <header>
      <p class="eyebrow">Proof surface</p>
      <h1 id="proof-title">All work</h1>
      <p>
        A deliberately small index of public artifacts. Each item keeps the claim,
        evidence, and caveat visible.
      </p>
    </header>

    <div class="section-label proof-label">
      <span>Projects</span>
      <span>Source-backed work</span>
    </div>

    <div class="proof-row" role="region" aria-label="Published projects">
      {workItems.map((entry: WorkEntry) => (
        <a class="proof-card" href={workRoute(entry)}>
          <span>{entry.data.date}</span>
          <h2>{entry.data.shortTitle}</h2>
          <p>{entry.data.proof.claim}</p>
          <dl>
            <div><dt>Evidence</dt><dd>{entry.data.proof.evidence}</dd></div>
            <div><dt>Limitation</dt><dd>{entry.data.proof.caveat}</dd></div>
          </dl>
        </a>
      ))}
    </div>

    <div class="section-label proof-label">
      <span>Writing and proof notes</span>
      <span>Curated evidence</span>
    </div>

    <div class="proof-row" role="region" aria-label="Featured proof">
      {liveProofItems.map((item: ProofItem) => (
        <a class="proof-card" href={item.href}>
          <span>{item.status}</span>
          <h2>{item.title}</h2>
          <p>{item.claim}</p>
          <dl>
            <div>
              <dt>Evidence</dt>
              <dd>{item.evidence}</dd>
            </div>
            <div>
              <dt>Caveat</dt>
              <dd>{item.caveat}</dd>
            </div>
            <div>
              <dt>Next state</dt>
              <dd>{item.nextState}</dd>
            </div>
          </dl>
        </a>
      ))}
    </div>

    {plannedProofItems.length > 0 && (
      <>
        <div class="section-label proof-label">
          <span>Planned lanes</span>
          <span>Not proof yet</span>
        </div>

        <div class="proof-row" role="region" aria-label="Planned proof lanes">
          {plannedProofItems.map((item: ProofItem) => (
            <div class="proof-card proof-card--planned">
              <span>{item.status}</span>
              <h2>{item.title}</h2>
              <p>{item.claim}</p>
              <dl>
                <div><dt>Evidence</dt><dd>{item.evidence}</dd></div>
                <div><dt>Caveat</dt><dd>{item.caveat}</dd></div>
                <div><dt>Next state</dt><dd>{item.nextState}</dd></div>
              </dl>
            </div>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .proof-card {
    max-width: 100%;
    min-width: 0;
  }

  .proof-card:focus-visible {
    outline-offset: -4px;
  }
</style>
