---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies, proofWorkCards } from "../../data/work";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;
---

<BaseLayout title={`${study.title} | brainwav case study`}>
  <article class="case-study section-shell" aria-labelledby="case-title">
    <header>
      <p class="eyebrow">Work / {study.date}</p>
      <h1 id="case-title">{study.title}</h1>
      <p>{study.subtitle}</p>
    </header>

    <div class="case-hero-art" aria-hidden="true">
      <div class="case-window case-window--left">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="case-window case-window--main">
        <p>{study.title}</p>
        <strong>{study.subtitle}</strong>
        <span></span>
        <span></span>
      </div>
      <div class="case-window case-window--right">
        <span></span>
        <span></span>
      </div>
    </div>

    <section class="case-detail-grid" aria-label="Case study detail">
      <div>
        <h2>Project overview</h2>
      </div>
      <div class="case-copy">
        <h3>About the organization</h3>
        <p>{study.organization}</p>
        <h3>What I did</h3>
        <p>{study.work}</p>
        <p>{study.overview}</p>
        <div class="tag-row case-tags">
          {study.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    </section>

    <section class="case-gallery" aria-label="Case study proof frames">
      {study.frames.map((frame) => (
        <div class="case-gallery-frame">
          <p>{frame[0]}</p>
          <h3>{frame[1]}</h3>
          <span>{frame[2]}</span>
          <i aria-hidden="true"></i>
        </div>
      ))}
    </section>

    <section class="work-carousel case-all-work" aria-labelledby="case-all-work-title">
      <h2 id="case-all-work-title">All work <sup>04</sup></h2>
      <div class="work-row" aria-label="More work">
        {proofWorkCards.map((item) => (
          <article class="work-mini-card">
            <div class={"work-thumbnail work-thumbnail--" + item.tone} aria-hidden="true">
              <span></span>
              <span></span>
            </div>
            <h3>{item.title}</h3>
            <div class="tag-row">
              {item.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
      <div class="carousel-controls" aria-hidden="true">
        <span>&lt;- Back</span>
        <span></span>
        <span>Next -&gt;</span>
      </div>
    </section>
  </article>
</BaseLayout>
