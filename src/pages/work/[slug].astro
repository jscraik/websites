---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnimatedButton from "../../components/AnimatedButton.astro";
import CarouselControls from "../../components/CarouselControls.astro";
import { getCollection } from "astro:content";
import { byOrder, proofWorkCards, workRoute } from "../../lib/portfolio";
import type { ProofEntry, WorkCard, WorkEntry } from "../../lib/portfolio";
type Study = WorkEntry["data"] & { slug: string; route: string };
type CaseStudyLink = NonNullable<WorkEntry["data"]["caseStudy"]>["links"][number];

export async function getStaticPaths() {
  const caseStudies: WorkEntry[] = (await getCollection("work"))
    .filter((entry: WorkEntry) => entry.data.publicationState !== "draft" && !entry.data.href)
    .sort(byOrder);
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { study: { slug: entry.id, route: workRoute(entry), ...entry.data } }
  }));
}

const { study } = Astro.props as { study: Study };
const workEntries: WorkEntry[] = (await getCollection("work")).sort(byOrder);
const proofEntries: ProofEntry[] = (await getCollection("proof")).sort(byOrder);
const workCards = proofWorkCards(workEntries, proofEntries);
const workCount = String(workCards.length).padStart(2, "0");
---

<BaseLayout title={`${study.title} | brAInwav case study`}>
  <article class="case-study" aria-labelledby="case-title">
    <header class="case-work-header section-shell">
      <div class="case-meta">
        <span class="icon-box case-meta__icon" aria-hidden="true">
          <svg viewBox="0 0 17 16" class="sm-icon" focusable="false">
            <path d="M13.889 6.854l1.243-1.243a2 2 0 0 0 0-2.828l-1.414-1.415a2 2 0 0 0-2.829 0L9.646 2.611" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="m14.01 6.732-4.242-4.242-7.368 7.367a.5.5 0 0 0-.141.283l-.589 4.125a.5.5 0 0 0 .565.565l4.125-.589a.5.5 0 0 0 .283-.141l7.367-7.368Z" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        <span>Work</span>
        <span aria-hidden="true">•</span>
        <span>{study.date}</span>
      </div>
      <h1 id="case-title">{study.title}</h1>
      <p>{study.subtitle}</p>
    </header>

    <figure class="case-hero-art section-shell" aria-label={`${study.title} case study visual`}>
      <div class="case-window case-window--left">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="case-window case-window--main">
        <p>{study.title}</p>
        <strong>{study.subtitle}</strong>
        <span></span>
        <span></span>
      </div>
      <div class="case-window case-window--right">
        <span></span>
        <span></span>
      </div>
    </figure>

    <section class="case-overview section-shell" aria-labelledby="case-overview-title">
      <h2 id="case-overview-title">Project overview</h2>
      <div class="case-detail-grid" aria-label="Case study detail">
        <div class="case-copy">
          <h3>About the organization</h3>
          <p>{study.organization}</p>
          <h3>What I did</h3>
          <p>{study.work}</p>
          <p>{study.overview}</p>
        </div>
        <aside class="case-sidebar" aria-label="Case study metadata">
          <div>
            <p class="input-label">My role</p>
            <p>{study.role}</p>
          </div>
          <div>
            <p class="input-label">Done with</p>
            <div class="tag-row case-tags">
              {study.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="case-proof-summary section-shell" aria-labelledby="case-proof-title">
      <p class="eyebrow">Inspectable boundary</p>
      <h2 id="case-proof-title">What this work proves</h2>
      <dl>
        <div>
          <dt>Claim</dt>
          <dd>{study.proof.claim}</dd>
        </div>
        <div>
          <dt>Evidence</dt>
          <dd>{study.proof.evidence}</dd>
        </div>
        <div>
          <dt>Caveat</dt>
          <dd>{study.proof.caveat}</dd>
        </div>
      </dl>
    </section>

    {study.caseStudy && (
      <>
        <section class="case-story section-shell" aria-labelledby="case-story-title">
          <div class="case-story__heading">
            <p class="eyebrow">From problem to proof</p>
            <h2 id="case-story-title">How the delivery unfolded</h2>
          </div>
          <div class="case-story__body">
            <article>
              <p class="input-label">Problem</p>
              <h3>{study.caseStudy.problem.title}</h3>
              <p>{study.caseStudy.problem.body}</p>
            </article>
            <article>
              <p class="input-label">Discovery</p>
              <h3>{study.caseStudy.discovery.title}</h3>
              <p>{study.caseStudy.discovery.body}</p>
            </article>
            <article>
              <p class="input-label">Constraints</p>
              <h3>{study.caseStudy.constraints.title}</h3>
              <ul>
                {study.caseStudy.constraints.items.map((constraint: string) => <li>{constraint}</li>)}
              </ul>
            </article>
            <article>
              <p class="input-label">Decisions</p>
              <h3>{study.caseStudy.decisions.title}</h3>
              <ul>
                {study.caseStudy.decisions.items.map((decision: string) => <li>{decision}</li>)}
              </ul>
            </article>
            <article>
              <p class="input-label">Delivery</p>
              <h3>{study.caseStudy.delivery.title}</h3>
              <p>{study.caseStudy.delivery.body}</p>
            </article>
            <article>
              <p class="input-label">Failure and correction</p>
              <h3>{study.caseStudy.correction.title}</h3>
              <p>{study.caseStudy.correction.body}</p>
            </article>
            <article>
              <p class="input-label">Outcome</p>
              <h3>{study.caseStudy.outcome.title}</h3>
              <p>{study.caseStudy.outcome.body}</p>
            </article>
          </div>
        </section>

        <section class="case-role-boundary section-shell" aria-labelledby="case-role-title">
          <div>
            <p class="eyebrow">Human-owned delivery</p>
            <h2 id="case-role-title">Directed by Jamie. Implemented with Codex.</h2>
          </div>
          <dl>
            <div>
              <dt>Jamie</dt>
              <dd>{study.caseStudy.roleBoundary.jamie}</dd>
            </div>
            <div>
              <dt>Codex</dt>
              <dd>{study.caseStudy.roleBoundary.codex}</dd>
            </div>
          </dl>
        </section>

        <section class="case-evidence section-shell" aria-labelledby="case-evidence-title">
          <div>
            <p class="eyebrow">Inspect the evidence</p>
            <h2 id="case-evidence-title">Follow the artifact, tests, and stated limits.</h2>
          </div>
          <div class="case-evidence__links">
            {study.caseStudy.links.map((link: CaseStudyLink) => (
              link.primary ? (
                <AnimatedButton
                  class="small-button--light"
                  href={link.href}
                  label={link.label}
                  rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                />
              ) : (
                <a href={link.href} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>{link.label}</a>
              )
            ))}
          </div>
        </section>
      </>
    )}

    <section class="work-carousel case-all-work" aria-labelledby="case-all-work-title">
      <h2 id="case-all-work-title">All work <sup>{workCount}</sup></h2>
      <div class="work-row" aria-label="More work" data-work-row>
        {workCards.map((item: WorkCard, index: number) => (
          <a class="work-mini-card" href={item.href}>
            <p class="work-card-count">{String(index + 1).padStart(2, "0")} / {workCount}</p>
            <div class={"work-thumbnail work-thumbnail--" + item.tone} aria-hidden="true">
              <span></span>
              <span></span>
            </div>
            <h3>{item.title}</h3>
            <div class="tag-row">
              {item.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
      <CarouselControls />
    </section>
  </article>
</BaseLayout>
