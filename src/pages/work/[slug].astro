---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CarouselControls from "../../components/CarouselControls.astro";
import { getCollection } from "astro:content";
import { byOrder, proofWorkCards, workRoute } from "../../lib/portfolio";
import type { ProofEntry, WorkCard, WorkEntry } from "../../lib/portfolio";
type Study = WorkEntry["data"] & { slug: string; route: string };

export async function getStaticPaths() {
  const caseStudies: WorkEntry[] = (await getCollection("work")).sort((a: WorkEntry, b: WorkEntry) => a.data.order - b.data.order);
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { study: { slug: entry.id, route: workRoute(entry), ...entry.data } }
  }));
}

const { study } = Astro.props as { study: Study };
const workEntries: WorkEntry[] = (await getCollection("work")).sort(byOrder);
const proofEntries: ProofEntry[] = (await getCollection("proof")).sort(byOrder);
const workCards = proofWorkCards(workEntries, proofEntries);
const workCount = String(workCards.length).padStart(2, "0");
---

<BaseLayout title={`${study.title} | brainwav case study`}>
  <article class="case-study" aria-labelledby="case-title">
    <header class="case-work-header section-shell">
      <div class="case-meta">
        <span class="icon-box case-meta__icon" aria-hidden="true">
          <svg viewBox="0 0 17 16" class="sm-icon" focusable="false">
            <path d="M13.889 6.854l1.243-1.243a2 2 0 0 0 0-2.828l-1.414-1.415a2 2 0 0 0-2.829 0L9.646 2.611" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="m14.01 6.732-4.242-4.242-7.368 7.367a.5.5 0 0 0-.141.283l-.589 4.125a.5.5 0 0 0 .565.565l4.125-.589a.5.5 0 0 0 .283-.141l7.367-7.368Z" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        <span>Work</span>
        <span aria-hidden="true">•</span>
        <span>{study.date}</span>
      </div>
      <h1 id="case-title">{study.title}</h1>
      <p>{study.subtitle}</p>
    </header>

    <figure class="case-hero-art section-shell" aria-label={`${study.title} case study visual`}>
      <div class="case-window case-window--left">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="case-window case-window--main">
        <p>{study.title}</p>
        <strong>{study.subtitle}</strong>
        <span></span>
        <span></span>
      </div>
      <div class="case-window case-window--right">
        <span></span>
        <span></span>
      </div>
    </figure>

    <section class="case-overview section-shell" aria-labelledby="case-overview-title">
      <h2 id="case-overview-title">Project overview</h2>
      <div class="case-detail-grid" aria-label="Case study detail">
        <div class="case-copy">
          <h3>About the organization</h3>
          <p>{study.organization}</p>
          <h3>What I did</h3>
          <p>{study.work}</p>
          <p>{study.overview}</p>
        </div>
        <aside class="case-sidebar" aria-label="Case study metadata">
          <div>
            <p class="input-label">My role</p>
            <p>{study.role}</p>
          </div>
          <div>
            <p class="input-label">Done with</p>
            <div class="tag-row case-tags">
              {study.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="case-gallery section-shell" aria-label="Case study proof frames">
      {study.frames.map((frame: [string, string, string]) => (
        <div class="case-gallery-frame">
          <p>{frame[0]}</p>
          <h3>{frame[1]}</h3>
          <span>{frame[2]}</span>
          <i aria-hidden="true"></i>
        </div>
      ))}
    </section>

    <section class="work-carousel case-all-work" aria-labelledby="case-all-work-title">
      <h2 id="case-all-work-title">All work <sup>{workCount}</sup></h2>
      <div class="work-row" aria-label="More work" data-work-row>
        {workCards.map((item: WorkCard, index: number) => (
          <a class="work-mini-card" href={item.href}>
            <p class="work-card-count">{String(index + 1).padStart(2, "0")} / {workCount}</p>
            <div class={"work-thumbnail work-thumbnail--" + item.tone} aria-hidden="true">
              <span></span>
              <span></span>
            </div>
            <h3>{item.title}</h3>
            <div class="tag-row">
              {item.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
      <CarouselControls />
    </section>
  </article>
</BaseLayout>
