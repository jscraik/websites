---
import BaseLayout from "../layouts/BaseLayout.astro";
import StartLinks from "../components/StartLinks.astro";
import CarouselControls from "../components/CarouselControls.astro";
import BrandWord from "../components/BrandWord.astro";
import Icon from "../components/Icon.astro";
import AnimatedButton from "../components/AnimatedButton.astro";
import { getCollection } from "astro:content";
import { byOrder, featuredWorkCards, proofWorkCards } from "../lib/portfolio";
import type { CollectionEntry } from "astro:content";
import type { ProofEntry, WorkCard, WorkEntry } from "../lib/portfolio";
import { publicProfile } from "../lib/public-profile";

type BlogEntry = CollectionEntry<"blog">;

const workEntries: WorkEntry[] = (await getCollection("work")).sort(byOrder);
const proofEntries: ProofEntry[] = (await getCollection("proof")).sort(byOrder);
const allBlogEntries: BlogEntry[] = (await getCollection("blog")).sort(byOrder);
const blogEntries = allBlogEntries.filter((entry) => entry.data.publicationState === "published");
const draftBlogEntries = allBlogEntries.filter((entry) => entry.data.publicationState === "draft");
const featuredBlog = blogEntries.find((entry) => entry.data.featured) ?? blogEntries[0];
if (!featuredBlog) {
  throw new Error("No blog entries found in the 'blog' content collection");
}
const featuredCards = featuredWorkCards(workEntries);
const workCards = proofWorkCards(workEntries, proofEntries);

const workCount = String(workCards.length).padStart(2, "0");
---

<BaseLayout title="Jamie Scott Craik | Software developer in transition" description={publicProfile.summary}>
  <header class="header-inner section-shell" aria-labelledby="home-title">
    <div class="home-hero" data-entry>
      <div class="home-hero__intro v-stack cc-lg">
        <p class="home-hero__identity">Jamie Scott Craik</p>
        <h1 id="home-title" class="home-hero__headline">I build software and developer tools with practical AI.</h1>
        <div>
          <p class="home-hero__body">
            I am moving into professional software development after 22 years of Army
            leadership, instruction, and operational delivery.
          </p>
          <div class="profile-row cc-home-hero" aria-label="Jamie Scott Craik">
            <div class="pfp-img-wrap">
              <img src="/jamie-profile-96.webp" alt="Jamie Scott Craik" class="u-img-cover" width="96" height="96" />
            </div>
            <div class="profile-row-meta">
              <div class="input-label">Army veteran · independent builder</div>
            </div>
          </div>
        </div>
      </div>
      <StartLinks />
    </div>
  </header>

  <section id="featured-work" class="featured-band section-shell" aria-labelledby="featured-title">
    <div class="section-label">
      <span>Featured work</span>
      <span>Curated projects</span>
    </div>
    <div class="featured-list">
      {featuredCards.map((card, index) => (
        <article class="feature-block" data-entry>
          <div class="feature-block-inner">
            <div class="feature-block__content">
              <h2 id={index === 0 ? "featured-title" : undefined}>
                {card.title === "brAInwav" ? (
                  <BrandWord />
                ) : card.title}
              </h2>
              <div class="feature-block__copy">
                <p class="eyebrow">{card.eyebrow}</p>
                <p class="feature-quote">"{card.quote}"</p>
              </div>
              <AnimatedButton href={card.href} label={card.cta} />
            </div>
            <div class={"feature-block-img feature-block-img--" + card.visual}>
              <div class="work-preview">
                <div class={card.visual === "skills" ? "skillsbar-artwork" : "work-preview__image work-preview__image--" + card.visual} aria-hidden="true">
                  {card.visual === "skills" ? (
                    <div class="skillsbar-preview">
                      <div class="skillsbar-preview__header">
                        <img src="/products/skillsbar/icon-112.webp" alt="" width="56" height="56" loading="lazy" decoding="async" />
                        <div>
                          <span>SkillsBar</span>
                          <small>Interactive evidence demo</small>
                        </div>
                      </div>
                      <div class="skillsbar-preview__status">
                        <p>Current local candidate</p>
                        <strong>Needs candidate identity</strong>
                        <span>1 receipt current · downstream proof held</span>
                      </div>
                      <div class="skillsbar-preview__track"><span></span></div>
                      <div class="skillsbar-preview__next">
                        <span>01</span>
                        <div><small>Next required</small><strong>Candidate identity</strong></div>
                      </div>
                    </div>
                  ) : card.visual === "terminal" ? (
                    <img class="project-outline" src={`/editorial/${card.illustration}-outline.svg`} alt="" width="1000" height="800" loading="lazy" decoding="async" />
                  ) : (
                    <>
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </>
                  )}
                </div>
                <div class="feature-proof-panel" aria-label={card.previewTitle}>
                  <p class="eyebrow">From the work</p>
                  <h3>{card.previewTitle}</h3>
                  <p>{card.previewMeta}</p>
                  <dl>
                    {card.frames.map(([label, value, description]) => (
                      <div>
                        <dt>{label}</dt>
                        <dd>
                          <span>{value}</span>
                          <small>{description}</small>
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="work" class="work-carousel section-shell" aria-labelledby="work-carousel-title" data-entry>
    <h2 id="work-carousel-title">All work <sup>{workCount}</sup></h2>
    <div class="work-row" aria-label="Curated proof cards" data-work-row>
      {workCards.map((item: WorkCard, index: number) => (
        <a class="work-mini-card" href={item.href}>
          <p class="work-card-count">{String(index + 1).padStart(2, "0")} / {workCount}</p>
          <div class={"work-thumbnail work-thumbnail--" + item.tone} aria-hidden="true">
            <img class="work-card-illustration" src={`/editorial/${item.illustration}-card.svg`} alt="" width="800" height="1000" loading="lazy" decoding="async" />
            <div class="work-thumbnail__cursor" data-work-card-cursor>
              <div class="work-thumbnail__arrow">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M0 8h14M14 8l-5-5M14 8l-5 5"></path>
                </svg>
              </div>
            </div>
          </div>
          <div class="work-card-body">
            <p>{item.eyebrow}</p>
            <h3>{item.title}</h3>
            <span>{item.summary}</span>
            <div class="tag-row">
              {item.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
    <CarouselControls />
  </section>

  <script>
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLElement>(".work-thumbnail").forEach((thumbnail) => {
      const cursor = thumbnail.querySelector<HTMLElement>("[data-work-card-cursor]");
      if (!cursor) return;

      let frame = 0;
      let currentX = 0;
      let currentY = 0;
      let targetX = 0;
      let targetY = 0;

      const render = () => {
        frame = 0;

        if (reducedMotion.matches) {
          currentX = 0;
          currentY = 0;
          targetX = 0;
          targetY = 0;
        } else {
          currentX += (targetX - currentX) * 0.22;
          currentY += (targetY - currentY) * 0.22;
        }

        cursor.style.setProperty("--work-cursor-x", `${currentX.toFixed(3)}px`);
        cursor.style.setProperty("--work-cursor-y", `${currentY.toFixed(3)}px`);

        if (Math.abs(targetX - currentX) > 0.08 || Math.abs(targetY - currentY) > 0.08) {
          frame = requestAnimationFrame(render);
        }
      };

      const requestRender = () => {
        if (!frame) frame = requestAnimationFrame(render);
      };

      const updateTarget = (event: PointerEvent) => {
        if (!finePointer.matches || reducedMotion.matches) return;

        const bounds = thumbnail.getBoundingClientRect();
        const normalizedX = (event.clientX - bounds.left) / bounds.width - 0.5;
        const normalizedY = (event.clientY - bounds.top) / bounds.height - 0.5;

        targetX = normalizedX * 32;
        targetY = normalizedY * 32;
        requestRender();
      };

      thumbnail.addEventListener("pointerenter", (event) => {
        if (!finePointer.matches) return;
        thumbnail.dataset.pointerActive = "true";
        updateTarget(event);
      });

      thumbnail.addEventListener("pointermove", updateTarget);

      const resetPointer = () => {
        delete thumbnail.dataset.pointerActive;
        targetX = 0;
        targetY = 0;
        requestRender();
      };

      thumbnail.addEventListener("pointerleave", resetPointer);
      thumbnail.addEventListener("pointercancel", resetPointer);
      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) resetPointer();
      });
    });
  </script>

  <section class="blog-preview section-shell" aria-labelledby="blog-preview-title" data-entry>
    <div class="blog-title-block">
      <div class="blog-heading-lockup">
        <h2 id="blog-preview-title">Blog</h2>
        <span class="icon-box blog-heading-icon" aria-hidden="true">
          <Icon name="pencil" />
        </span>
      </div>
      <div class="blog-preview__drafts" aria-label="In my drafts">
        <p class="eyebrow">Writing next</p>
        {draftBlogEntries.map((draft) => (
          <a
            href={draft.data.proofLink}
            aria-label={`Inspect evidence related to draft: ${draft.data.title}`}
          >
            {draft.data.title}
          </a>
        ))}
      </div>
    </div>
    <article>
      <a class="blog-preview__image" href={featuredBlog.data.href} aria-label={`Read ${featuredBlog.data.title}`}>
        <img src="/editorial/when-evidence-goes-stale-v1.webp" alt="Evidence belongs to Candidate A; an interrupted connection prevents it transferring to the changed Candidate B." width="1672" height="941" loading="lazy" decoding="async" />
      </a>
      <h3>{featuredBlog.data.title}</h3>
      <p class="article-date">{featuredBlog.data.date}</p>
      <p>{featuredBlog.data.summary}</p>
      <AnimatedButton
        class="small-button--light"
        href={featuredBlog.data.href}
        label="Keep reading"
      />
    </article>
  </section>

</BaseLayout>
