---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { securityStageStates, stageSymbol } from "../../lib/skillsbar-demo-fixtures";
const stages = [
  ["Identity", "The exact source package is known and bound to its package ID, source revision and content digest, with provenance and ownership recorded."],
  ["Validation", "The plugin and its skills meet the applicable structural, metadata, resource, reference and presentation requirements."],
  ["Security", "Applicable security and permission checks have acceptable evidence, with no unresolved risk blocking evaluation or release."],
  ["Eval prep", "Scenarios, assertions, scoring criteria and scorer calibration are ready; comparison settings and budgets are frozen."],
  ["Local eval", "Baseline and candidate have been compared under matched local conditions, and any accepted winner is selected and frozen."],
  ["Cloud eval", "Cloud refinement has been compared against the accepted local winner under matched cloud conditions, with a recorded selection decision."],
  ["Staging", "The selected release archive, required resources, presentation, recovery plan and registry preparation are verified, including the final scoped security check."],
  ["Publication", "The authorised, exact checked version has been published to the selected registry and verified by readback."],
  ["Runtime", "That version has been installed and its discovery, activation and behaviour verified, with rollback evidence where applicable."],
];
---
<BaseLayout title="SkillsBar | Interactive demo" description="Explore SkillsBar’s current nine-stage inspector with labelled example data." bodyClass="skillsbar-demo-page">
  <header class="demo-nav section-shell"><a href="/work/skillsbar/">← SkillsBar case study</a><span>Interactive example</span></header>
  <section class="demo-intro section-shell" aria-labelledby="demo-title">
    <p class="demo-kicker">SkillsBar · Interactive demo</p>
    <h1 id="demo-title">See what needs attention next.</h1>
    <p>Select a stage to inspect its evidence without changing the next required check.</p>
    <p class="demo-boundary">Example data · No commands are executed</p>
    <details class="fixture-note"><summary>About this example data</summary><p>This browser demo uses fixed example data. It does not read your skills, run SDK commands or contact Tessl. All security findings are synthetic. The nine stages describe the intended lifecycle; several still need implementation or live integration proof.</p></details>
    <noscript><section class="scenario-fallback"><h2>Example states</h2><dl><dt>Security review required</dt><dd>Identity and Validation passed; Security needs review and six stages await proof.</dd><dt>Identity missing</dt><dd>The source package is not identified; later stages await proof.</dd><dt>Installed copy found</dt><dd>Files exist on disk, but checked source and completed lifecycle evidence remain unproven.</dd></dl><p>JavaScript enables stage selection and command copying. Stage definitions remain available below.</p></section></noscript>
  </section>
  <section class="demo-layout section-shell" aria-label="Interactive SkillsBar inspector">
    <div class="focus-inspector">
      <header class="inspector-header"><img src="/products/skillsbar/icon-112.webp" width="48" height="48" alt="" /><div><p class="app-label">SKILLS SDK</p><strong>improve-agent-native</strong><p><span class="local-tag" id="origin">Local</span> <span class="attention" id="header-status">Needs attention</span></p></div></header>
      <fieldset class="scenario-control"><legend>Demo scenario</legend><button type="button" class="scenario" data-scenario="security" aria-pressed="true">Security review required</button><button type="button" class="scenario" data-scenario="identity" aria-pressed="false">Identity missing</button><button type="button" class="scenario" data-scenario="installed" aria-pressed="false">Installed copy found</button></fieldset>
      <div class="stage-grid" role="group" aria-label="Nine evidence gates">{stages.map(([name], index) => <button type="button" class="stage" aria-pressed={index === 2 ? "true" : "false"} data-status={securityStageStates[index]} data-next={String(index === 2)} aria-label={`Gate ${index + 1}: ${name}, ${securityStageStates[index]}${index === 2 ? ", next required" : ""}`}><span>{String(index + 1).padStart(2, "0")}</span><span class="stage-symbol" aria-hidden="true">{stageSymbol(securityStageStates[index])}</span><strong>{name}</strong><small class="stage-state">{securityStageStates[index]}</small></button>)}</div>
      <p id="pipeline-summary" class="stage-summary">2 passed · 1 needs review · 6 awaiting proof</p>
      <section class="stage-detail" aria-labelledby="action-title"><div class="gate-context"><span id="gate-index">Gate 03 / 09</span><span id="next-required">Next required</span></div><h2 id="action-title">Security</h2><p id="detail-status" data-status="Review required" data-next="true">Review required · 1 critical · 2 high (synthetic)</p><p id="action-detail">Full security receipt missing or malformed. Inspect findings before continuing.</p><div id="command-actions" hidden><details id="command-disclosure"><summary>Show command</summary><pre><code id="command-text">./bin/ask sdk start Skills/agent-ops/improve-agent-native --json --robot</code></pre></details><button id="copy-command" type="button">Copy command</button></div><p id="command-unavailable">Visual reference · no executable command</p><p id="copy-status" role="status" aria-live="polite"></p></section>
      <details class="registry-details"><summary>Tessl Registry <span id="registry-state">Unavailable</span></summary><p id="registry-description">No cached registry evidence in this fixture.</p><p>Registry evidence stays separate from local checks. A registry score cannot pass a local gate.</p></details>
      <button id="refresh-demo" class="refresh-button" type="button">↻ Refresh example</button><p id="scenario-status" class="u-visually-hidden" role="status" aria-live="polite"></p>
    </div>
    <aside class="demo-reading"><p class="demo-kicker">EXPLORE THE INSPECTOR</p><h2>Keep the next check in view.</h2><dl><div><dt>Select any stage</dt><dd>Amber marks the next required stage. Blue marks another stage you’re inspecting. Selection never advances a gate.</dd></div><div><dt>Use the keyboard</dt><dd>Focus a stage and use the arrow keys. Home and End move to the first and last stages.</dd></div><div><dt>Inspect before copying</dt><dd>Choose Identity missing and expand Show command. Copy command only copies the text.</dd></div><div><dt>Refresh the same example</dt><dd>Your selection stays in place. Changing the scenario returns to its next required stage.</dd></div></dl><p>The native app also offers a skill chooser in its ellipsis menu. This focused demo does not simulate filesystem access.</p><a href="/work/skillsbar/">Read the SkillsBar case study ↗</a></aside>
  </section>
  <section class="lifecycle section-shell" aria-labelledby="lifecycle-title"><h2 id="lifecycle-title">What each gate should prove</h2><p>These are target evidence requirements, not a claim that every route is executable end to end.</p><ol>{stages.map(([name, description]) => <li><h3>{name}</h3><p>{description}</p></li>)}</ol><p>Security remains active throughout, including a final scoped check at Staging. A changed candidate invalidates affected evidence and dependent stages; independently valid upstream evidence can remain. Publication and Runtime require readback and behaviour evidence from the registry and host adapters.</p></section>
  <script>
    import { securityStageStates, stageSymbol } from "../../lib/skillsbar-demo-fixtures";
    const names = ["Identity", "Validation", "Security", "Eval prep", "Local eval", "Cloud eval", "Staging", "Publication", "Runtime"];
    const command = "./bin/ask sdk start Skills/agent-ops/improve-agent-native --json --robot";
    const scenarios = {
      security: { next: 2, summary: "2 passed · 1 needs review · 6 awaiting proof", states: securityStageStates },
      identity: { next: 0, summary: "1 needs review · 8 awaiting proof", states: ["Review required", "Held", "Held", "Held", "Unproven", "Unproven", "Unproven", "Unproven", "Unproven"] },
      installed: { next: 0, summary: "Installed copy found · 9 stages unproven", states: Array<string>(9).fill("Unproven") },
    };
    let scenario: keyof typeof scenarios = "security";
    let selected = 2;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".stage")];
    const text = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };
    const render = () => {
      const data = scenarios[scenario];
      buttons.forEach((button, index) => {
        const state = data.states[index];
        button.setAttribute("aria-pressed", String(index === selected));
        button.setAttribute("aria-label", `Gate ${index + 1}: ${names[index]}, ${state}${index === data.next ? ", next required" : ""}`);
        button.dataset.next = String(index === data.next);
        button.dataset.status = state;
        const symbol = button.querySelector(".stage-symbol"); const label = button.querySelector(".stage-state");
        if (symbol) symbol.textContent = stageSymbol(state);
        if (label) label.textContent = state;
      });
      document.querySelectorAll<HTMLButtonElement>(".scenario").forEach(button => button.setAttribute("aria-pressed", String(button.dataset.scenario === scenario)));
      text("origin", scenario === "installed" ? "Installed" : "Local");
      text("header-status", scenario === "installed" ? "Unproven" : "Needs attention");
      text("pipeline-summary", data.summary); text("gate-index", `Gate ${String(selected + 1).padStart(2, "0")} / 09`);
      text("next-required", selected === data.next ? "Next required" : `Next required: ${names[data.next]}`); text("action-title", names[selected]);
      text("detail-status", scenario === "security" && selected === 2 ? "Review required · 1 critical · 2 high (synthetic)" : data.states[selected]);
      text("action-detail", scenario === "installed" ? "Finding files does not establish checked source, registry version or completed lifecycle evidence. This installed copy has no checked-source link." : scenario === "identity" ? "The canonical package digest is missing. Later evidence cannot count until the source package is identified." : selected < 2 ? "The example receipt matches the current package digest." : selected === 2 ? "Full security receipt missing or malformed. Inspect findings before continuing." : "This stage awaits its own current package evidence. Security remains the next required check.");
      const detail = document.getElementById("detail-status");
      if (detail) { detail.dataset.status = data.states[selected]; detail.dataset.next = String(selected === data.next); }
      const canCopy = scenario === "identity" && selected === 0;
      const actions = document.getElementById("command-actions"); const unavailable = document.getElementById("command-unavailable");
      if (actions) actions.hidden = !canCopy; if (unavailable) unavailable.hidden = canCopy;
      text("command-unavailable", scenario === "security" ? "Visual reference · no executable command" : "No command available for this stage");
      text("registry-state", scenario === "identity" ? "Example baseline" : scenario === "installed" ? "Not Linked" : "Unavailable");
      text("registry-description", scenario === "identity" ? "Synthetic historical example: score 66, 1.28× lift. Observation time unavailable. This is not a live registry result." : scenario === "installed" ? "No registry identity is assumed for an installed copy." : "No cached registry evidence in this fixture.");
      text("scenario-status", `${data.summary}. Inspecting ${names[selected]}. Next required: ${names[data.next]}.`);
    };
    const select = (index: number) => { selected = index; const disclosure = document.getElementById("command-disclosure"); if (disclosure instanceof HTMLDetailsElement) disclosure.open = false; text("copy-status", ""); render(); };
    buttons.forEach((button, index) => {
      button.addEventListener("click", () => select(index));
      button.addEventListener("keydown", event => {
        const offsets: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 3, ArrowUp: -3 }; const offset = offsets[event.key];
        if (event.key !== "Home" && event.key !== "End" && offset === undefined) return;
        event.preventDefault(); const next = event.key === "Home" ? 0 : event.key === "End" ? 8 : Math.max(0, Math.min(8, index + offset)); select(next); buttons[next].focus();
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".scenario").forEach(button => button.addEventListener("click", () => { const key = button.dataset.scenario; if (key !== "security" && key !== "identity" && key !== "installed") return; scenario = key; select(scenarios[scenario].next); }));
    document.getElementById("copy-command")?.addEventListener("click", async () => { try { await navigator.clipboard.writeText(command); text("copy-status", "Command copied. Nothing has been run."); } catch { const disclosure = document.getElementById("command-disclosure"); if (disclosure instanceof HTMLDetailsElement) disclosure.open = true; text("copy-status", "Clipboard unavailable. Select the command text and copy it manually."); } });
    document.getElementById("refresh-demo")?.addEventListener("click", () => { render(); text("copy-status", "Example refreshed. Selection and evidence are unchanged."); });
    render();
  </script>
</BaseLayout>

<style>
  .demo-nav { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0 1rem; font-size: .875rem; }
  .demo-nav span { color: var(--text-muted); }
  .demo-nav a, .demo-reading a { text-decoration: underline; text-underline-offset: .25em; text-decoration-thickness: from-font; }
  .demo-intro { padding-block: clamp(1.5rem, 3vw, 3rem) 2rem; text-align: center; }
  .demo-kicker { color: var(--text-muted); font: 600 .8125rem var(--body-mono); letter-spacing: .06em; text-transform: uppercase; }
  #demo-title { max-width: 52rem; margin: 1rem auto; color: var(--editorial-title); font-family: var(--body-serif); font-size: clamp(3rem, 6vw, 6rem); font-weight: 300; line-height: 1.05; text-wrap: balance; }
  .demo-intro > p { max-width: 42rem; margin-inline: auto; line-height: 1.6; text-wrap: pretty; }
  .fixture-note { max-width: 42rem; margin: 1rem auto 0; font-size: .875rem; color: var(--text-muted); }
  .fixture-note p { font-size: .875rem; line-height: 1.6; text-align: start; }
  .demo-intro .demo-boundary { font-size: .8125rem; color: var(--text-muted); margin-block: 1rem 0; }
  .demo-layout { display: grid; grid-template-columns: minmax(0, 28.75rem) minmax(0, 25rem); justify-content: center; align-items: start; gap: clamp(2rem, 6vw, 6rem); padding-bottom: 4rem; }
  .focus-inspector { min-width: 0; padding: 1rem; border: 1px solid var(--border-subtle); border-radius: 1rem; background: oklch(.235 .004 220); color: #f5f5f7; font: 400 1rem/1.4 -apple-system, BlinkMacSystemFont, sans-serif; }
  .inspector-header { display: flex; gap: .75rem; align-items: center; }
  .inspector-header img { flex-shrink: 0; border-radius: .75rem; }
  .inspector-header > div { min-width: 0; }
  .inspector-header strong { overflow-wrap: anywhere; font-size: 1.125rem; }
  .inspector-header p { margin: .25rem 0; color: #d2d3d7; font-size: .8125rem; }
  .app-label { font-weight: 600; }
  .local-tag { color: #69d9ee; border: 1px solid #69d9ee; border-radius: .5rem; padding: .0625rem .25rem; }
  .attention { color: #ffcf74; }
  .scenario-control { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0; padding: .75rem 0; border: 0; border-block: 1px solid #ffffff26; }
  .scenario-control legend { font-size: .8125rem; }
  .scenario { min-height: 2.75rem; padding: .375rem .625rem; border: 1px solid #777; border-radius: .5rem; color: #f5f5f7; background: transparent; font-size: .8125rem; cursor: pointer; }
  .scenario[aria-pressed="true"] { border-color: #69d9ee; background: #69d9ee18; }
  .stage-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .375rem; }
  .stage { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: .25rem; padding: .5rem .375rem; min-height: 4.25rem; border: 1px solid var(--border-subtle); border-radius: .625rem; color: #f5f5f7; background: #ffffff05; font: inherit; cursor: pointer; }
  .stage > span:first-child { justify-self: start; font-variant-numeric: tabular-nums; }
  .stage strong, .stage-state { grid-column: 1 / -1; }
  .stage strong { font-size: .875rem; font-weight: 600; white-space: nowrap; }
  .stage-state { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .stage-symbol { justify-self: center; font-weight: 700; }
  .stage[data-status="Passed"] .stage-symbol { color: oklch(.8 .15 150); }
  .stage[data-next="true"] { border-color: #ffbf47; }
  .stage[aria-pressed="true"] { border-color: #69b5ff; background: #69b5ff18; }
  .stage[aria-pressed="true"][data-next="true"] { border-color: #ffbf47; background: #ffbf4718; }
  .focus-inspector button:focus-visible, .focus-inspector summary:focus-visible { outline: 2px solid white; outline-offset: 3px; }
  .stage-summary { margin: .75rem 0; color: #d2d3d7; font-size: .875rem; }
  .stage-detail { border-block: 1px solid #ffffff26; padding: 1rem 0; min-height: 13rem; }
  .gate-context { display: flex; justify-content: space-between; gap: .5rem; color: #d2d3d7; font-size: .8125rem; font-variant-numeric: tabular-nums; }
  #action-title { margin: .5rem 0; color: #f5f5f7; font: 650 1.5rem/1.2 -apple-system, BlinkMacSystemFont, sans-serif; }
  .stage-detail p { font-size: .9375rem; margin: .75rem 0; }
  #detail-status { color: #d2d3d7; font-weight: 600; }
  #detail-status[data-next="true"] { color: #ffcf74; }
  #detail-status[data-status="Passed"] { color: oklch(.8 .15 150); }
  #command-actions[hidden], #command-unavailable[hidden] { display: none; }
  summary { cursor: pointer; min-height: 2.75rem; padding-block: .625rem; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: .75rem; background: #191b1e; border-radius: .5rem; font-size: .8125rem; }
  #copy-command { width: 100%; min-height: 2.75rem; border: 0; border-radius: .625rem; background: #0867db; color: white; font: 600 1rem -apple-system, BlinkMacSystemFont, sans-serif; cursor: pointer; }
  #copy-status { color: #d2d3d7; font-size: .8125rem; }
  .registry-details { border-bottom: 1px solid #ffffff26; padding-block: .5rem; }
  .registry-details summary { font-weight: 600; }
  .registry-details summary span { color: #69d9ee; font-size: .8125rem; margin-left: .5rem; }
  .registry-details p { color: #d2d3d7; font-size: .875rem; }
  .refresh-button { width: 100%; padding: .75rem 0 0; min-height: 2.75rem; border: 0; background: transparent; color: #d2d3d7; text-align: left; font: inherit; cursor: pointer; }
  .demo-reading h2, .lifecycle > h2 { margin-top: 1rem; color: var(--editorial-title); font-family: var(--body-serif); font-size: clamp(2.25rem, 4vw, 3.5rem); font-weight: 300; line-height: 1.08; text-wrap: balance; }
  .demo-reading > h2, #lifecycle-title { color: var(--editorial-title); font-weight: 300; }
  .demo-reading dl { margin-block: 2rem; }
  .demo-reading dl div { padding-block: 1rem; border-top: 1px solid var(--border-subtle); }
  .demo-reading dt { font-weight: 600; }
  .demo-reading dd { margin: .5rem 0 0; font-size: 1rem; line-height: 1.6; color: var(--text-muted); }
  .demo-reading > p { font-size: 1rem; }
  .demo-nav > a, .demo-reading > a { display: inline-flex; align-items: center; min-height: 44px; }
  .lifecycle { padding-block: 3rem 5rem; border-top: 1px solid var(--border-subtle); }
  .lifecycle ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; padding-left: 1.5rem; }
  .lifecycle h3 { margin-block: .5rem; font-size: 1.5rem; }
  .lifecycle li p { font-size: 1rem; line-height: 1.6; color: var(--text-muted); }
  @media (max-width: 47rem) { .demo-layout { grid-template-columns: minmax(0, 28.75rem); } .focus-inspector { padding: .75rem; } .stage strong { font-size: .8125rem; } .gate-context { font-size: .75rem; } .lifecycle ol { grid-template-columns: 1fr; } }
</style>
