---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css";
import { publicProfile } from "../lib/public-profile";

const quickLinks = [
  { label: "Fun facts", href: "#fun-facts", icon: "person" },
  { label: "Skills", href: "#skills", icon: "wand" },
  { label: "Work History", href: "#current-focus", icon: "file" },
  { label: "On the web", href: "#on-the-web", icon: "globe" }
];

const otherInterests = [
  {
    kicker: "Outdoors",
    title: "Rock climbing",
    detail: "I’m a Joint Service Rock Climbing Leader, on single-pitch and multi-pitch.",
    meta: "Joint Service Rock Climbing Leader",
  },
  {
    kicker: "On the water",
    title: "Sailing",
    detail: "I hold RYA Competent Crew, from a sailing course in Kiel in 2009.",
    meta: "RYA Competent Crew · 2009",
  },
  {
    kicker: "Coaching",
    title: "Cycling",
    detail: "I’m a qualified British Cycling Level 2 coach.",
    meta: "Level 2 coaching qualification",
  },
  {
    kicker: "Before software",
    title: "Army chef",
    detail: "I started my Army career as a chef and won a bronze medal at the Combined Services Culinair competition.",
    meta: "Combined Services Culinair",
  }
];

const personalCards = [
  { category: "Background", title: "British Army", detail: "22 years of service, leadership and instruction.", image: "jamie-army.webp", alt: "Jamie during his Army service, in uniform and yellow protective glasses.", width: 800, height: 1000, treatment: "portrait" },
  { category: "Cycling", title: "The helmet that saved my life", detail: "This helmet saved my life but it marked the day my military career died.", image: "cycling-helmet.webp", alt: "The inside of Jamie's cycling helmet, showing deep cracks through the protective foam.", width: 1000, height: 750, treatment: "photo" },
  { category: "Family nickname", title: "Grumpy Grinch", detail: "My kids call me Grumpy Grinch because they think I don’t like Christmas.", image: "grumpy-grinch.webp", alt: "Illustration of green Grinch hands forming a heart, with red Christmas sleeves.", width: 900, height: 900, treatment: "illustration" },
  { category: "Active hobby", title: "Macro photography", detail: "Getting closer to the small details. One of my flower photographs.", image: "macro-flower.webp", alt: "Jamie's close-up photograph of a bright pink flower, with the garden softly blurred behind it.", width: 750, height: 1000, treatment: "photo" }
];

const skills = [
  {
    icon: "spark",
    title: "Software development",
    detail: "Turning product goals into small, testable software systems with clear behavior and honest limits."
  },
  {
    icon: "proof",
    title: "Technical communication",
    detail: "Explaining technical choices, commands, results, and limitations in language a maintainer can use."
  },
  {
    icon: "tool",
    title: "Developer tooling",
    detail: "Designing small command-line and desktop tools with predictable inputs, outputs, and failure paths."
  },
  {
    icon: "standard",
    title: "Instruction and standards",
    detail: "Using a military instruction background to make complex technical work executable and inspectable."
  }
];

const capabilities = [
  "Software Development",
  "Developer Experience",
  "Technical Writing",
  "AI-assisted Delivery",
  "Testing",
  "CLI Tools",
  "Technical Education",
  "Instruction"
];

const history = [
  {
    title: "Independent software projects",
    badge: "Current",
    dates: publicProfile.independentSince + " - Present",
    roles: ["Portfolio products", "AI-assisted software delivery"],
    detail: [
      "Directing and inspecting SkillsBar, Skills SDK, research CLIs, and this portfolio as independent work rather than paid employment."
    ]
  },
  {
    title: "Professional learning",
    badge: "Current",
    dates: "Ongoing",
    roles: ["Software development", "Structured learning"],
    detail: [
      "Building on verified leadership and management qualifications up to Level 7 while developing practical software skills through project work.",
      "I’m studying a full-time BTEC HNC in Digital Technologies for England, on the Software Development and Programming pathway, at University Campus North Lincolnshire. I expect to finish in May 2027 and am looking for full-time work from June 2027."
    ]
  },
  {
    title: "British Army",
    dates: publicProfile.background.service,
    roles: ["Warrant Officer", "Instruction and standards", "Operational delivery"],
    detail: [
      "Standards, training, operational delivery, logistics, management, and leadership under pressure."
    ]
  }
];

const webLinks = [
  ["Now", "GitHub", "Public code and proof notes", "github.com/jscraik", "https://github.com/jscraik"],
  ["Now", "LinkedIn", "Professional profile", "linkedin.com/in/jscraik", "https://linkedin.com/in/jscraik"],
  ["Now", "X", "Short-form build notes", "@jscraik", "https://x.com/jscraik"],
  ["Open", "Email", "Direct contact", "jscraik@brainwav.io", "mailto:jscraik@brainwav.io"]
];
---

<BaseLayout title="About | Jamie Scott Craik" description="Jamie Scott Craik brings 22 years of Army leadership and instruction to a career switch into professional software development.">
  <header class="about-page about-hero-shell" aria-labelledby="about-title">
    <div class="about-intro">
      <div class="about-copy-block">
        <h1 id="about-title">About</h1>
        <div class="about-copy">
          <p>I’m Jamie Scott Craik, a software development student and former Warrant Officer Class 1 living in Middle Rasen, Lincolnshire.</p>
          <section class="about-evolve" aria-labelledby="evolve-title">
            <h2 id="evolve-title">Evolve</h2>
            <p>Twenty-two years in the Army took me from chef to instructor, infantry soldier, senior instructor, squadron sergeant major, logistics manager and service delivery manager.</p>
            <p>Now I study software development and build AI skill tools with Codex, OpenAI’s coding agent.</p>
          </section>
          <p>I’ve been developing independent software projects since November 2024. My main projects are Skills SDK, a Python tool that checks AI agent skills before they’re shared or installed, and SkillsBar, a macOS menu-bar app that brings those results together.</p>
          <p>I use Codex, an AI coding agent, to write most of the code. I set the requirements, review the changes and take responsibility for testing and documentation.</p>
          <p>I’m studying a full-time BTEC HNC in Digital Technologies for England, on the Software Development and Programming pathway, at University Campus North Lincolnshire. I expect to finish in May 2027 and am looking for full-time work from June 2027.</p>
          <p>I’m interested in software development and forward deployed engineering or AI solutions roles where I can combine technical work with explaining systems and helping people use them.</p>
          <a class="about-contact-link" href="/contact/">Contact me about a role <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="about-hero-spacer" aria-hidden="true"></div>
      <aside class="about-sidebar">
        <div class="about-jump">
          <p class="eyebrow">Get to know me</p>
          <nav aria-label="About page sections">
            {quickLinks.map((item) => (
              <a href={item.href}>
                <span class={`jump-icon jump-icon--${item.icon}`} aria-hidden="true"></span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
        </div>
        <img
          class="about-portrait"
          src="/personal/jamie-developer.webp"
          alt="Jamie Scott Craik"
          width="900"
          height="900"
        />
      </aside>
    </div>
  </header>

  <section id="fun-facts" class="about-band" aria-labelledby="fun-facts-title">
    <div class="about-band-heading">
      <h2 id="fun-facts-title">Fun facts</h2>
      <p class="eyebrow">Interests and background</p>
    </div>
    <div class="about-photo-grid">
      {personalCards.map((card) => (
        <article class="about-photo-card">
          <div class={`about-photo-media about-photo-media--${card.treatment}`}>
            <span class="about-photo-category">{card.category}</span>
            <img src={`/personal/${card.image}`} alt={card.alt} width={card.width} height={card.height} loading="lazy" decoding="async" />
          </div>
          <h3>{card.title}</h3>
          <p>{card.detail}</p>
        </article>
      ))}
    </div>
    <div class="about-card-grid about-interest-notes">
      {otherInterests.filter((fact) => fact.title !== "Cycling").map((fact) => (
        <article class="about-fact-card">
          <p class="about-fact-label">{fact.kicker}</p>
          <h3>{fact.title}</h3>
          <p>{fact.meta}</p>
          <span>{fact.detail}</span>
        </article>
      ))}
    </div>
  </section>

  <section id="skills" class="about-band about-skills-band" aria-labelledby="skills-title">
    <div class="about-skills-stack">
      <h2 id="skills-title">Skills</h2>
      <div class="about-skill-list">
        {skills.map((skill) => (
          <article>
            <span class="about-skill-icon" aria-hidden="true"><Icon name={skill.icon === "spark" ? "code" : skill.icon === "tool" ? "terminal" : skill.icon === "standard" ? "checklist" : "document"} /></span>
            <div>
              <h3>{skill.title}</h3>
              <p>{skill.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="about-capabilities">
        <h3>All Capabilities</h3>
        <ul class="about-capability-list" aria-label="All capabilities">
          {capabilities.map((capability) => (
            <li>{capability}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="current-focus" class="about-band about-work-history-band" aria-labelledby="focus-title">
    <div class="about-history-stack">
      <h2 id="focus-title">Work history</h2>
      <ul class="history-list" role="list">
        {history.map((item) => (
          <li class="history-list-item">
            <article>
              <div class="work-history-inner cc-top">
                <div class="history-flex">
                  <h3>{item.title}</h3>
                </div>
                <div class="u-d-tablet-none" aria-hidden="true"></div>
                <div class="history-flex history-flex--meta">
                  {item.badge && <span class="about-history-badge">{item.badge}</span>}
                  <span class="about-history-date">{item.dates}</span>
                </div>
              </div>
              <div class="work-history-inner">
                <div class="history-flex cc-vertical">
                  {item.roles.map((role) => (
                    <span>{role}</span>
                  ))}
                </div>
                <div class="u-d-tablet-none" aria-hidden="true"></div>
                <div class="history-flex">
                  <div class="about-history-copy">
                    {item.detail.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="on-the-web" class="about-band about-web-band" aria-labelledby="web-title">
    <div class="about-web-stack">
      <h2 id="web-title">On the web</h2>
      <ul class="recognition-list" role="list">
        <li class="recognition-list-li cc-header" aria-hidden="true">
          <div><span class="input-label u-text-black">Date</span></div>
          <div><span class="input-label u-text-black">Venue</span></div>
          <div><span class="input-label u-text-black">Occasion</span></div>
          <div><span class="input-label u-text-black">Subject</span></div>
        </li>
        {webLinks.map(([date, venue, occasion, value, href]) => (
          <li class="recognition-list-li">
            <div><span class="input-label">{date}</span></div>
            <div>
              <a class="input-label cc-link" href={href}>{venue}</a>
            </div>
            <div><span class="input-label">{occasion}</span></div>
            <div><span class="input-label">{value}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
