---
import BaseLayout from "../layouts/BaseLayout.astro";

const quickLinks = [
  { label: "Fun Facts", href: "#fun-facts", icon: "person" },
  { label: "Skills", href: "#skills", icon: "wand" },
  { label: "Work History", href: "#current-focus", icon: "file" },
  { label: "On the web", href: "#on-the-web", icon: "globe" }
];

const funFacts = [
  {
    kicker: "Background",
    title: "British Army",
    detail: "Ten years of standards, instruction, logistics, and people leadership still shape how I work.",
    artifact: "Field note",
    meta: "10 years",
    visual: "army"
  },
  {
    kicker: "Current rabbit hole",
    title: "AI workflows",
    detail: "I spend a lot of time testing where agents help, where they drift, and how humans keep hold of the work.",
    artifact: "Notebook",
    meta: "Current",
    visual: "agents"
  },
  {
    kicker: "Small tools",
    title: "CLI projects",
    detail: "I like tiny developer tools that are easy to explain, easy to run, and honest about their limits.",
    artifact: "Terminal",
    meta: "Small tools",
    visual: "terminal"
  },
  {
    kicker: "Taste",
    title: "Receipts over hype",
    detail: "The work I trust most shows its reasoning, its evidence, and the boundary of what it can claim.",
    artifact: "Note",
    meta: "Taste",
    visual: "receipt"
  }
];

const skills = [
  {
    icon: "spark",
    title: "AI-native DevRel",
    detail: "Explaining agent workflows, trust surfaces, evals, and developer education without hiding the verification burden."
  },
  {
    icon: "proof",
    title: "Proof-led writing",
    detail: "Turning drafts, commands, screenshots, caveats, and validation receipts into public-safe articles and notes."
  },
  {
    icon: "tool",
    title: "Developer workflow design",
    detail: "Designing small tools, docs, and examples that help developers move from curiosity to repeatable use."
  },
  {
    icon: "standard",
    title: "Instruction and standards",
    detail: "Using a military instruction background to make complex technical work executable and inspectable."
  }
];

const history = [
  {
    title: "brAInwav",
    meta: "2026 / current / personal site",
    detail: "Building the public home for AI-native DevRel writing, proof notes, and small developer-facing demos."
  },
  {
    title: "Codex workflows",
    meta: "current / agent work / validation",
    detail: "Shaping repeatable loops for agent tasks, review, validation, and evidence-aware closeout."
  },
  {
    title: "rsearch and wsearch",
    meta: "candidate portfolio units / CLI",
    detail: "Tightening small developer tools into documented examples with command receipts and tutorial paths."
  },
  {
    title: "British Army",
    meta: "10 years / warrant officer",
    detail: "Standards, training, operational delivery, logistics, management, and leadership under pressure."
  }
];

const webLinks = [
  ["Now", "GitHub", "Public code and proof notes", "github.com/jscraik", "https://github.com/jscraik"],
  ["Now", "LinkedIn", "Professional profile", "linkedin.com/in/jscraik", "https://linkedin.com/in/jscraik"],
  ["Now", "X", "Short-form build notes", "@jscraik", "https://x.com/jscraik"],
  ["Open", "Email", "Direct contact", "jscraik@brainwav.io", "mailto:jscraik@brainwav.io"]
];
---

<BaseLayout title="About | brAInwav">
  <section class="about-page section-shell" aria-labelledby="about-title">
    <header class="about-intro">
      <div class="about-copy-block">
        <h1 id="about-title">About</h1>
        <div class="about-copy">
          <p>
            I am building toward AI-native Developer Relations: public writing,
            proof surfaces, developer tools, and education that make agentic work
            easier to trust.
          </p>
          <p>
            Before this, I spent ten years as a British Army Warrant Officer.
            Standards, instruction, operational delivery, and people leadership
            still shape how I think about software.
          </p>
          <p>
            brAInwav is the public record of that transition: the articles,
            receipts, experiments, and caveats that show the work while it is
            being built.
          </p>
        </div>
      </div>
      <aside class="about-sidebar">
        <div class="about-jump">
          <p class="eyebrow">Get to know me</p>
          <nav aria-label="About page sections">
            {quickLinks.map((item) => (
              <a href={item.href}>
                <span class={`jump-icon jump-icon--${item.icon}`} aria-hidden="true"></span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
        </div>
        <img class="about-portrait" src="/jamie-profile.png" alt="Jamie Scott Craik" />
      </aside>
    </header>

    <section id="fun-facts" class="about-band" aria-labelledby="fun-facts-title">
      <h2 id="fun-facts-title">Fun Facts</h2>
      <p class="eyebrow">Updated July 2026</p>
      <div class="about-card-grid">
        {funFacts.map((fact) => (
          <article class="about-fact-card">
            <div class={`about-object about-object--${fact.visual}`} aria-hidden="true">
              <span>{fact.artifact}</span>
              <i></i>
              <i></i>
              <i></i>
            </div>
            <h3>{fact.title}</h3>
            <p>{fact.kicker} / {fact.meta}</p>
            <span>{fact.detail}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="about-band about-split" aria-labelledby="skills-title">
      <div>
        <p class="eyebrow">Skills</p>
        <h2 id="skills-title">Skills</h2>
      </div>
      <div class="about-skill-list">
        {skills.map((skill) => (
          <article>
            <span class={`skill-icon skill-icon--${skill.icon}`} aria-hidden="true"></span>
            <h3>{skill.title}</h3>
            <p>{skill.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="current-focus" class="about-band about-split" aria-labelledby="focus-title">
      <div>
        <p class="eyebrow">Work history</p>
        <h2 id="focus-title">Work history</h2>
      </div>
      <div class="about-history">
        {history.map((item) => (
          <article>
            <p>{item.meta}</p>
            <h3>{item.title}</h3>
            <span>{item.detail}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="on-the-web" class="about-band about-split" aria-labelledby="web-title">
      <div>
        <p class="eyebrow">On the web</p>
        <h2 id="web-title">On the web</h2>
      </div>
      <div class="web-table">
        <div class="web-table-header" aria-hidden="true">
          <span>Date</span>
          <span>Venue</span>
          <span>Occasion</span>
          <span>Subject</span>
        </div>
        {webLinks.map(([date, venue, occasion, value, href]) => (
          <a href={href}>
            <span>{date}</span>
            <span>{venue}</span>
            <span>{occasion}</span>
            <span>{value}</span>
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
