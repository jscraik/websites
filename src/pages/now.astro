---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Now | brainwav">
  <section class="plain-page section-shell">
    <div>
      <p class="eyebrow">Now</p>
      <h1>Current focus</h1>
    </div>
    <div class="stacked-list">
      <section>
        <h2>Build the public surface</h2>
        <p>
          Shape brainwav.io as a calm public record for AI-native DevRel writing, proof
          logs, and small developer-facing demos.
        </p>
      </section>
      <section>
        <h2>Tighten proof artifacts</h2>
        <p>
          Convert rsearch and wsearch into inspectable, documented CLI proof units with
          clear install, run, and validation paths.
        </p>
      </section>
      <section>
        <h2>Publish one useful article at a time</h2>
        <p>
          Start with the trust gap in AI-native DevRel, then publish practical notes on
          agent workflows, evals, and verification.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
