---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css";
import { publicProfile } from "../lib/public-profile";

const quickLinks = [
  { label: "Fun Facts", href: "#fun-facts", icon: "person" },
  { label: "Skills", href: "#skills", icon: "wand" },
  { label: "Work History", href: "#current-focus", icon: "file" },
  { label: "On the web", href: "#on-the-web", icon: "globe" }
];

const funFacts = [
  {
    kicker: "Background",
    title: "British Army",
    detail: "Twenty-two years of service, including 7.5 years at Warrant Officer rank, shape how I lead, teach, and work.",
    artifact: "Field note",
    meta: publicProfile.background.service,
    visual: "army"
  },
  {
    kicker: "Current rabbit hole",
    title: "AI workflows",
    detail: "I spend a lot of time testing where agents help, where they drift, and how humans keep hold of the work.",
    artifact: "Notebook",
    meta: "Current",
    visual: "agents"
  },
  {
    kicker: "Small tools",
    title: "CLI projects",
    detail: "I like tiny developer tools that are easy to explain, easy to run, and honest about their limits.",
    artifact: "Terminal",
    meta: "Small tools",
    visual: "terminal"
  },
  {
    kicker: "Taste",
    title: "Receipts over hype",
    detail: "The work I trust most shows its reasoning, its evidence, and the boundary of what it can claim.",
    artifact: "Note",
    meta: "Taste",
    visual: "receipt"
  }
];

const skills = [
  {
    icon: "spark",
    title: "Software development",
    detail: "Turning product goals into small, testable software systems with clear behavior and honest limits."
  },
  {
    icon: "proof",
    title: "Technical communication",
    detail: "Explaining technical choices, commands, results, and limitations in language a maintainer can use."
  },
  {
    icon: "tool",
    title: "Developer tooling",
    detail: "Designing small command-line and desktop tools with predictable inputs, outputs, and failure paths."
  },
  {
    icon: "standard",
    title: "Instruction and standards",
    detail: "Using a military instruction background to make complex technical work executable and inspectable."
  }
];

const capabilities = [
  "Software Development",
  "Developer Experience",
  "Technical Writing",
  "AI-assisted Delivery",
  "Testing",
  "CLI Tools",
  "Technical Education",
  "Instruction"
];

const history = [
  {
    title: "Independent software projects",
    badge: "Current",
    dates: publicProfile.independentSince + " - Present",
    roles: ["Portfolio products", "AI-assisted software delivery"],
    detail: [
      "Directing and inspecting SkillsBar, Skills SDK, research CLIs, and this portfolio as independent work rather than paid employment."
    ]
  },
  {
    title: "Professional learning",
    badge: "Current",
    dates: "Ongoing",
    roles: ["Software development", "Structured learning"],
    detail: [
      "Building on verified leadership and management qualifications up to Level 7 while developing practical software skills through project work.",
      "My planned study is the UCNL HNC Level 4 Digital Technologies – Software Development & Programming Pathway FT, alongside the Google Project Management and Google Cybersecurity Professional Certificates. These are study intentions, not completed qualifications or a claim of enrollment; dates are not yet confirmed."
    ]
  },
  {
    title: "British Army",
    dates: publicProfile.background.service,
    roles: ["Warrant Officer", "Instruction and standards", "Operational delivery"],
    detail: [
      "Standards, training, operational delivery, logistics, management, and leadership under pressure."
    ]
  }
];

const webLinks = [
  ["Now", "GitHub", "Public code and proof notes", "github.com/jscraik", "https://github.com/jscraik"],
  ["Now", "LinkedIn", "Professional profile", "linkedin.com/in/jscraik", "https://linkedin.com/in/jscraik"],
  ["Now", "X", "Short-form build notes", "@jscraik", "https://x.com/jscraik"],
  ["Open", "Email", "Direct contact", "jscraik@brainwav.io", "mailto:jscraik@brainwav.io"]
];
---

<BaseLayout title="About | Jamie Scott Craik" description="Jamie Scott Craik brings 22 years of Army leadership and instruction to a career switch into professional software development.">
  <header class="about-page about-hero-shell" aria-labelledby="about-title">
    <div class="about-intro">
      <div class="about-copy-block">
        <h1 id="about-title">About</h1>
        <div class="about-copy">
          <p>
            I am moving into professional software development through independent
            products, developer tools, and structured learning. I use AI to help
            implement the work while I set direction, inspect results, test
            behavior, and own what is presented.
          </p>
          <p>
            Before moving into software, I served 22 years in the British Army,
            including 7.5 years at Warrant Officer rank. Standards, instruction,
            operational delivery, and people leadership still shape how I work.
          </p>
          <p>
            My earlier career was built around logistics, instruction, standards,
            and helping people perform under pressure. I now apply those habits
            to software: make the goal clear, test the actual path, and explain
            the limits alongside the result.
          </p>
          <p>
            This portfolio is the public record of that transition: working
            projects, case studies, technical writing, and the decisions behind
            them.
          </p>
          <p>
            My CV is available to <a href="/cv/jamie-scott-craik-cv.pdf" download>download as a PDF</a>
            or <a href="/cv/jamie-scott-craik-cv.docx" download>download as a Word document</a>.
          </p>
        </div>
      </div>
      <div class="about-hero-spacer" aria-hidden="true"></div>
      <aside class="about-sidebar">
        <div class="about-jump">
          <p class="eyebrow">Get to know me</p>
          <nav aria-label="About page sections">
            {quickLinks.map((item) => (
              <a href={item.href}>
                <span class={`jump-icon jump-icon--${item.icon}`} aria-hidden="true"></span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
        </div>
        <img
          class="about-portrait"
          src="/jamie-profile-360x480.webp"
          alt="Jamie Scott Craik"
          width="360"
          height="480"
        />
      </aside>
    </div>
  </header>

  <section id="fun-facts" class="about-band" aria-labelledby="fun-facts-title">
    <div class="about-band-heading">
      <h2 id="fun-facts-title">Fun Facts</h2>
      <p class="eyebrow">Updated July 2026</p>
    </div>
    <div class="about-card-grid">
      {funFacts.map((fact) => (
        <article class="about-fact-card">
          <div class={`about-object about-object--${fact.visual}`} aria-hidden="true">
            <span class="about-fact-label">{fact.kicker}</span>
            <span class="about-object__artifact">{fact.artifact}</span>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <h3>{fact.title}</h3>
          <p>{fact.meta}</p>
          <span>{fact.detail}</span>
        </article>
      ))}
    </div>
  </section>

  <section id="skills" class="about-band about-skills-band" aria-labelledby="skills-title">
    <div class="about-skills-stack">
      <h2 id="skills-title">Skills</h2>
      <div class="about-skill-list">
        {skills.map((skill) => (
          <article>
            <span class={`skill-icon skill-icon--${skill.icon}`} aria-hidden="true"></span>
            <div>
              <h3>{skill.title}</h3>
              <p>{skill.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="about-capabilities">
        <h3>All Capabilities</h3>
        <ul class="about-capability-list" aria-label="All capabilities">
          {capabilities.map((capability) => (
            <li>{capability}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="current-focus" class="about-band about-work-history-band" aria-labelledby="focus-title">
    <div class="about-history-stack">
      <h2 id="focus-title">Work history</h2>
      <ul class="history-list" role="list">
        {history.map((item) => (
          <li class="history-list-item">
            <article>
              <div class="work-history-inner cc-top">
                <div class="history-flex">
                  <h3>{item.title}</h3>
                </div>
                <div class="u-d-tablet-none" aria-hidden="true"></div>
                <div class="history-flex history-flex--meta">
                  {item.badge && <span class="about-history-badge">{item.badge}</span>}
                  <span class="about-history-date">{item.dates}</span>
                </div>
              </div>
              <div class="work-history-inner">
                <div class="history-flex cc-vertical">
                  {item.roles.map((role) => (
                    <span>{role}</span>
                  ))}
                </div>
                <div class="u-d-tablet-none" aria-hidden="true"></div>
                <div class="history-flex">
                  <div class="about-history-copy">
                    {item.detail.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="on-the-web" class="about-band about-web-band" aria-labelledby="web-title">
    <div class="about-web-stack">
      <h2 id="web-title">On the web</h2>
      <ul class="recognition-list" role="list">
        <li class="recognition-list-li cc-header" aria-hidden="true">
          <div><span class="input-label u-text-black">Date</span></div>
          <div><span class="input-label u-text-black">Venue</span></div>
          <div><span class="input-label u-text-black">Occasion</span></div>
          <div><span class="input-label u-text-black">Subject</span></div>
        </li>
        {webLinks.map(([date, venue, occasion, value, href]) => (
          <li class="recognition-list-li">
            <div><span class="input-label">{date}</span></div>
            <div>
              <a class="input-label cc-link" href={href}>{venue}</a>
            </div>
            <div><span class="input-label">{occasion}</span></div>
            <div><span class="input-label">{value}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
