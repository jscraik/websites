    <div>
      <p class="eyebrow">404 · Page not found</p>
      <h1 id="not-found-title">That page isn’t here.</h1>
      <p>The address may have changed. You can return to the portfolio or browse the proof index.</p>
      <p><a class="large-link" href="/">Return to the homepage</a></p>
      <p><a class="large-link" href="/proof/">Browse the proof index</a></p>
    </div>
  </section>
</BaseLayout>
