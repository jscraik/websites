            "@openai/agents-realtime"
          ]
        }
      ],
      "requiredPackages": [
        {
          "package": "@brainwav/design-system-guidance",
          "dependencyType": "either",
          "requiredWhenCapabilities": [
            "ui",
            "chatgpt_apps_sdk"
          ]
        }
      ]
    },
    "projectBrainMemoryExtension": {
      "enabled": true,
      "requiredPaths": [
        ".harness/README.md",
        ".harness/memory/LEARNINGS.md",
        ".harness/active-artifacts.md",
